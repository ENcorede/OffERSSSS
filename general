@dp.message(CommandStart())
async def start(message: Message, state: FSMContext):
    register_user(message.from_user)
    await state.clear()

    # Сначала отправляем отдельное сообщение с нужной иконкой.
    icon_message = await message.answer(E_START)

    # Затем отправляем главное меню.
    menu_message = await message.answer(
        f"{E_WELCOME} <b>Telegram Offers</b>\n\n"
        "Создавайте предложения, договаривайтесь о стоимости "
        "подарков и отслеживайте состояние сделок.",
        reply_markup=main_keyboard(),
    )

    # Сохраняем ID сообщения меню для редактирования интерфейса.
    await state.update_data(
        ui_chat_id=menu_message.chat.id,
        ui_message_id=menu_message.message_id,
    )


@dp.message(Command("cancel"))
async def cancel_command(message: Message, state: FSMContext):
    data = await state.get_data()
    await state.clear()

    chat_id = data.get("ui_chat_id")
    message_id = data.get("ui_message_id")

    await delete_user_message(message)

    if chat_id and message_id:
        edited = await edit_bot_message(
            chat_id,
            message_id,
            f"{E_WELCOME} <b>Telegram Offers</b>\n\n"
            "Действие отменено.",
            main_keyboard(),
        )

        if edited is not None:
            return

    await message.answer(
        f"{E_WELCOME} <b>Действие отменено</b>",
        reply_markup=main_keyboard(),
    )


@dp.callback_query(F.data == "nav:exit")
