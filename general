@dp.message(OfferForm.username)
async def offer_username(message: Message, state: FSMContext):
    logger.info(
        "Получен username: user=%s, text=%r, state=%s",
        message.from_user.id,
        message.text,
        await state.get_state(),
    )

    register_user(message.from_user)

    raw = (message.text or "").strip()
    await delete_user_message(message)

    username = normalize_username(raw)

    if not re.fullmatch(r"[A-Za-z0-9_]{5,32}", username):
        await render_ui(
            state,
            f"{E_REJECT} <b>Некорректный username</b>\n\n"
            "Введите корректный username, например <code>@feyewer</code>.",
            nav_keyboard(),
        )
        return

    recipient = find_user(username)

    if not recipient:
        await render_ui(
            state,
            f"{E_REJECT} <b>Получатель не найден</b>\n\n"
            f"Введено: <code>@{escape(username)}</code>\n\n"
            "Пользователь должен открыть этого бота и нажать /start. "
            "После этого введите username ещё раз.",
            nav_keyboard(),
        )
        return

    if recipient["user_id"] == message.from_user.id:
        await render_ui(
            state,
            f"{E_REJECT} <b>Нельзя отправить оффер самому себе</b>\n\n"
            "Введите username другого пользователя.",
            nav_keyboard(),
        )
        return

    await state.update_data(
        recipient_id=recipient["user_id"],
        recipient_username=recipient["username"] or username,
    )

    await state.set_state(OfferForm.currency)

    await render_ui(
        state,
        f"{E_OFFER} <b>Выберите валюту</b>\n\n"
        f"{E_STARS} Stars\n"
        f"{E_GRAM} Gram\n"
        f"{E_RUB} RUB\n"
        f"{E_USD} USD",
        currency_keyboard(),
    )

    logger.info(
        "Переход к валюте выполнен: recipient_id=%s",
        recipient["user_id"],
    )


