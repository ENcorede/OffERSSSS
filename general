async def main():
    if not BOT_TOKEN or BOT_TOKEN == "ВСТАВЬ_СЮДА_ТОКЕН":
        raise RuntimeError(
            "Укажи токен в переменной окружения BOT_TOKEN."
        )

    if not ADMIN_IDS:
        logger.warning(
            "ADMIN_IDS не задан: функции проверки сделок администраторами "
            "будут недоступны."
        )

    logger.info("Бот запущен")

    try:
        await dp.start_polling(bot)
    finally:
        await bot.session.close()


if __name__ == "__main__":
