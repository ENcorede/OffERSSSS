async def finalize_rejection(offer_id, admin_id, comment=""):
    offer = get_offer(offer_id)

    if not offer or offer["status"] != "review":
        return False

    update_offer(
        offer_id,
        "rejected_review",
        reviewed_by=admin_id,
        review_comment=comment or None,
    )

    text = (
        f"{E_REJECT} <b>Сделка отклонена</b>\n"
        f"Заказ: <code>#{offer['deal_code']}</code>"
    )

    if comment:
        text += f"\nПричина: {escape(comment)}"

    for uid in (offer["sender_id"], offer["recipient_id"]):
        try:
            await bot.send_message(uid, text)
        except TelegramAPIError:
            pass

    return True


@dp.callback_query(F.data.startswith("admin:reject_empty:"))
async def admin_reject_empty(
    call: CallbackQuery,
    state: FSMContext,
):
    if call.from_user.id not in ADMIN_IDS:
        await safe_answer(call, "Недостаточно прав.", True)
        return

    offer_id = int(call.data.rsplit(":", 1)[1])

    if not await finalize_rejection(
        offer_id,
        call.from_user.id,
    ):
        await safe_answer(call, "Заявка уже обработана.", True)
        return

    await state.clear()
    await edit_or_send(
        call.message,
        f"{E_REJECT} <b>Заявка отклонена</b>",
    )

    await safe_answer(call, "Отклонено.")


@dp.message(AdminReviewForm.comment)
async def admin_rejection_comment(
    message: Message,
    state: FSMContext,
):
    if message.from_user.id not in ADMIN_IDS:
        await state.clear()
        return

    data = await state.get_data()
    offer_id = data.get("review_offer_id")
    comment = (message.text or "").strip()

    await delete_user_message(message)

    if not offer_id:
        await state.clear()
        return

    if not comment or len(comment) > 1000:
        await render_ui(
            state,
            "Введите причину длиной от 1 до 1000 символов.",
            admin_reject_keyboard(offer_id),
        )
        return

    if not await finalize_rejection(
        offer_id,
        message.from_user.id,
        comment,
    ):
        await state.clear()
        return

    offer = get_offer(offer_id)
    await state.clear()

    result = await message.answer(
        f"{E_REJECT} <b>Заявка отклонена</b>\n"
        f"Заказ: <code>#{offer['deal_code']}</code>",
        reply_markup=main_keyboard(),
    )
    await save_ui(state, result)


# ========================= FALLBACK =========================

@dp.message()
async def fallback(message: Message, state: FSMContext):
    register_user(message.from_user)

    logger.info(
        "Fallback: user=%s, state=%s, text=%r",
        message.from_user.id,
        await state.get_state(),
        message.text,
    )

    # Активное состояние не сбрасываем и не перехватываем.
    if await state.get_state() is not None:
        return

    await delete_user_message(message)

    data = await state.get_data()

    if data.get("ui_chat_id") and data.get("ui_message_id"):
        await render_ui(
            state,
            f"{E_MENU} <b>Telegram Offers</b>\n\n"
            "Используйте кнопки на экране или отправьте /start.",
            main_keyboard(),
        )
    else:
        menu = await message.answer(
            f"{E_MENU} <b>Telegram Offers</b>\n\n"
            "Используйте /start для открытия меню.",
            reply_markup=main_keyboard(),
        )
        await save_ui(state, menu)


