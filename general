async def deliver_pending_offers(user):
    if not user or not user.username:
        return

    pending = db.execute("""
        SELECT *
        FROM offers
        WHERE status = 'pending_delivery'
          AND recipient_username IS NOT NULL
          AND lower(recipient_username) = ?
    """, (user.username.lower(),)).fetchall()

    for row in pending:
        try:
            await bot.send_message(
                user.id,
                build_recipient_offer_text(row),
                reply_markup=incoming_keyboard(row["id"]),
                link_preview_options=NO_PREVIEW,
            )

            db.execute("""
                UPDATE offers
                SET recipient_id = ?, status = 'pending'
                WHERE id = ?
            """, (user.id, row["id"]))
            db.commit()

            await bot.send_message(
                row["sender_id"],
                f"{E_ACCEPT} Оффер <code>{row['code']}</code> "
                f"доставлен получателю "
                f"@{escape(row['recipient_username'])}.",
            )

        except TelegramAPIError:
            logger.exception("Ошибка доставки оффера %s", row["code"])


