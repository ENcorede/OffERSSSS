@dp.callback_query(F.data.startswith("deal:transfer:"))
async def deal_transfer(call: CallbackQuery):
    try:
        offer_id = int(call.data.rsplit(":", 1)[1])
    except (ValueError, IndexError):
        await safe_answer(call, "Некорректная сделка.", True)
        return

    offer = get_offer(offer_id)

    if offer is None or offer["recipient_id"] != call.from_user.id:
        await safe_answer(call, "Сделка не найдена.", True)
        return

    if offer["status"] != "deal_open":
        await safe_answer(
            call,
            "Сделка уже отправлена на проверку или закрыта.",
            True,
        )
        return

    # Статус меняется до уведомления администраторов,
    # чтобы повторные нажатия не создавали новые заявки.
    update_offer(offer_id, "review")

    text = (
        f"{E_CLOCK} <b>Передача отправлена на проверку</b>\n\n"
        f"Заказ: <code>#{offer['deal_code']}</code>\n"
        f"Стоимость: {offer['amount']} "
        f"{currency_icon(offer['currency'])} "
        f"{escape(offer['currency'])}\n\n"
        "Статус: <b>Ожидает проверки администраторами</b>\n\n"
        "После проверки вы получите уведомление."
    )

    await edit_or_send(
        call.message,
        text,
        main_keyboard(),
    )

    await notify_user(
        offer["sender_id"],
        f"{E_CLOCK} По сделке <code>#{offer['deal_code']}</code> "
        "началась проверка администраторами.",
        main_keyboard(),
    )

    await notify_admins_about_review(offer_id)

    await safe_answer(
        call,
        "Заявка отправлена администраторам.",
        True,
    )


