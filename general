@dp.message(OfferForm.gifts)
async def offer_add_gift(message: Message, state: FSMContext):
    url = (message.text or "").strip()
    await delete_user_message(message)

    if not re.fullmatch(
        r"(?:https?://\S+|(?:t\.me|telegram\.me)/\S+)",
        url,
        re.IGNORECASE,
    ):
        data = await state.get_data()

        await render_ui(
            state,
            f"{E_OFFER} <b>Добавление подарков</b>\n\n"
            f"Добавлено подарков: <b>{len(data.get('gift_urls', []))}</b>\n\n"
            "Ссылка не распознана. Отправьте корректную ссылку.",
            gifts_keyboard(),
        )
        return

    if not url.lower().startswith(("http://", "https://")):
        url = "https://" + url

    data = await state.get_data()
    urls = data.get("gift_urls", [])

    if url not in urls and len(urls) < 20:
        urls.append(url)
        await state.update_data(gift_urls=urls)

    await render_ui(
        state,
        f"{E_OFFER} <b>Добавление подарков</b>\n\n"
        f"Добавлено подарков: <b>{len(urls)}</b>\n\n"
        "Отправьте следующую ссылку или нажмите «Готово».",
        gifts_keyboard(),
    )


