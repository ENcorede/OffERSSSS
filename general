# DATABASE
# ============================================================

db = sqlite3.connect(DB_PATH)
db.row_factory = sqlite3.Row

db.execute("""
CREATE TABLE IF NOT EXISTS users (
    user_id INTEGER PRIMARY KEY,
    username TEXT,
    first_name TEXT,
    joined_at TEXT NOT NULL
)
""")

db.execute("""
CREATE TABLE IF NOT EXISTS offers (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    code TEXT UNIQUE NOT NULL,
    sender_id INTEGER NOT NULL,
    recipient_id INTEGER NOT NULL,
    recipient_username TEXT,
    currency TEXT NOT NULL,
    amount INTEGER NOT NULL,
    gift_url TEXT NOT NULL,
    status TEXT NOT NULL DEFAULT 'pending',
    deal_code TEXT UNIQUE,
    created_at TEXT NOT NULL,
    reviewed_by INTEGER,
    reviewed_at TEXT,
    review_comment TEXT
)
""")

# Миграция для существующей базы данных.
existing_columns = {
    row["name"]
    for row in db.execute("PRAGMA table_info(offers)").fetchall()
}

for column, declaration in (
    ("reviewed_by", "INTEGER"),
    ("reviewed_at", "TEXT"),
    ("review_comment", "TEXT"),
):
    if column not in existing_columns:
        db.execute(
            f"ALTER TABLE offers ADD COLUMN {column} {declaration}"
        )

db.commit()


def now_iso():
    return datetime.now(timezone.utc).isoformat()


def register_user(user):
    if user is None:
        return

    db.execute("""
        INSERT INTO users (
            user_id, username, first_name, joined_at
        )
        VALUES (?, ?, ?, ?)
        ON CONFLICT(user_id) DO UPDATE SET
            username = excluded.username,
            first_name = excluded.first_name
    """, (
        user.id,
        user.username,
        user.first_name or "",
        now_iso(),
    ))

    db.commit()


def find_user(username):
    username = username.strip().lstrip("@").lower()

    return db.execute("""
        SELECT * FROM users
        WHERE lower(username) = ?
        LIMIT 1
    """, (username,)).fetchone()


def get_user(user_id):
    return db.execute(
        "SELECT * FROM users WHERE user_id = ?",
        (user_id,),
    ).fetchone()


def create_offer(
    sender_id,
    recipient,
    currency,
    amount,
    gift_url,
):
    code = secrets.token_hex(5).upper()

    cur = db.execute("""
        INSERT INTO offers (
            code,
            sender_id,
            recipient_id,
            recipient_username,
            currency,
            amount,
            gift_url,
            status,
            created_at
        )
        VALUES (?, ?, ?, ?, ?, ?, ?, 'pending', ?)
    """, (
        code,
        sender_id,
        recipient["user_id"],
        recipient["username"],
        currency,
        amount,
        gift_url,
        now_iso(),
    ))

    db.commit()

    return code, cur.lastrowid


def get_offer(offer_id):
    return db.execute(
        "SELECT * FROM offers WHERE id = ?",
        (offer_id,),
    ).fetchone()


def update_offer(
    offer_id,
    status,
    deal_code=None,
    reviewed_by=None,
    review_comment=None,
):
    db.execute("""
        UPDATE offers
        SET
            status = ?,
            deal_code = COALESCE(?, deal_code),
            reviewed_by = COALESCE(?, reviewed_by),
            reviewed_at = CASE
                WHEN ? IS NOT NULL THEN ?
                ELSE reviewed_at
            END,
            review_comment = COALESCE(?, review_comment)
        WHERE id = ?
    """, (
        status,
        deal_code,
        reviewed_by,
        reviewed_by,
        now_iso(),
        review_comment,
        offer_id,
    ))

    db.commit()


def generate_deal_code():
    alphabet = string.ascii_uppercase + string.digits

    while True:
        suffix = "".join(
            secrets.choice(alphabet)
            for _ in range(8)
        )

        code = "TG-" + suffix

        exists = db.execute(
            "SELECT 1 FROM offers WHERE deal_code = ?",
            (code,),
        ).fetchone()

        if not exists:
            return code


