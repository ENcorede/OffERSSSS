db = sqlite3.connect(DB_NAME)
db.row_factory = sqlite3.Row

db.execute("PRAGMA journal_mode=WAL")
db.execute("PRAGMA foreign_keys=ON")

db.executescript("""
CREATE TABLE IF NOT EXISTS users (
    user_id INTEGER PRIMARY KEY,
    username TEXT,
    first_name TEXT,
    can_create INTEGER NOT NULL DEFAULT 0,
    created_at TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS offers (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    public_id TEXT UNIQUE NOT NULL,
    seller_id INTEGER NOT NULL,
    buyer_id INTEGER NOT NULL,
    buyer_username TEXT,
    gift_links TEXT NOT NULL,
    currency TEXT NOT NULL,
    amount INTEGER NOT NULL,
    status TEXT NOT NULL DEFAULT 'pending',
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    FOREIGN KEY(seller_id) REFERENCES users(user_id),
    FOREIGN KEY(buyer_id) REFERENCES users(user_id)
);

CREATE TABLE IF NOT EXISTS user_states (
    user_id INTEGER PRIMARY KEY,
    state TEXT NOT NULL,
    data TEXT NOT NULL DEFAULT '{}'
);

CREATE TABLE IF NOT EXISTS notifications (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER NOT NULL,
    offer_id INTEGER NOT NULL,
    created_at TEXT NOT NULL,
    UNIQUE(user_id, offer_id),
    FOREIGN KEY(offer_id) REFERENCES offers(id)
);

CREATE TABLE IF NOT EXISTS admin_logs (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    admin_id INTEGER NOT NULL,
    action TEXT NOT NULL,
    created_at TEXT NOT NULL
);
""")

db.commit()


def now() -> str:
    return datetime.now().strftime("%Y-%m-%d %H:%M:%S")


def execute(sql, params=()):
    cur = db.execute(sql, params)
    db.commit()
    return cur


def get_user(user_id: int):
    return db.execute(
        "SELECT * FROM users WHERE user_id=?",
        (user_id,),
    ).fetchone()


def register_user(user):
    existing = get_user(user.id)

    if existing:
        execute(
            """
            UPDATE users
            SET username=?, first_name=?
            WHERE user_id=?
            """,
            (
                user.username,
                user.first_name,
                user.id,
            ),
        )
    else:
        execute(
            """
            INSERT INTO users
            (user_id, username, first_name, can_create, created_at)
            VALUES (?, ?, ?, ?, ?)
            """,
            (
                user.id,
                user.username,
                user.first_name,
                1 if user.id in ADMIN_IDS else 0,
                now(),
            ),
        )


def has_access(user_id: int) -> bool:
    if user_id in ADMIN_IDS:
        return True

    row = get_user(user_id)
    return bool(row and row["can_create"])


def get_state(user_id: int):
    row = db.execute(
        "SELECT * FROM user_states WHERE user_id=?",
        (user_id,),
    ).fetchone()

    if not row:
        return None, {}

    import json

    try:
        data = json.loads(row["data"])
    except Exception:
        data = {}

    return row["state"], data


def set_state(user_id: int, state: str, data=None):
    import json

    execute(
        """
        INSERT INTO user_states (user_id, state, data)
        VALUES (?, ?, ?)
        ON CONFLICT(user_id)
        DO UPDATE SET state=excluded.state, data=excluded.data
        """,
        (
            user_id,
            state,
            json.dumps(data or {}, ensure_ascii=False),
        ),
    )


def clear_state(user_id: int):
    execute(
        "DELETE FROM user_states WHERE user_id=?",
        (user_id,),
    )


def is_admin(user_id: int) -> bool:
