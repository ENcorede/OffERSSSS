        status TEXT NOT NULL DEFAULT 'pending',
        deal_code TEXT UNIQUE,
        created_at TEXT NOT NULL,
        reviewed_by INTEGER,
        reviewed_at TEXT,
        review_comment TEXT
    )
""")

columns = {
