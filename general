@dp.message(Command("dostup"))
async def admin_access(message: Message):
    if not is_admin(message.from_user.id):
        return

    parts = message.text.split()

    if len(parts) != 2 or not parts[1].startswith("@"):
        await message.answer(
            "Использование: <code>/dostup @username</code>"
        )
        return

    username = parts[1].lstrip("@")

    user = resolve_username(username)

    if not user:
        await message.answer(
            "Пользователь не найден. Он должен сначала "
            "запустить бота, чтобы попасть в базу."
        )
        return

    execute(
        "UPDATE users SET can_create=1 WHERE user_id=?",
        (user["user_id"],),
    )

    log_admin(
        message.from_user.id,
        f"dostup {user['user_id']}",
    )

    await message.answer(
        f"✅ Пользователю @{escape(user['username'] or username)} "
        "выдан доступ к созданию офферов."
    )

    try:
        await bot.send_message(
            user["user_id"],
            "✅ Вам выдан доступ к созданию офферов.",
        )
    except Exception:
        pass


