async def save_ui(state: FSMContext, message: Message):
    await state.update_data(
        ui_chat_id=message.chat.id,
        ui_message_id=message.message_id,
    )


async def render_ui(
    state: FSMContext,
    text: str,
    keyboard=None,
):
    data = await state.get_data()

    chat_id = data.get("ui_chat_id")
    message_id = data.get("ui_message_id")

    if not chat_id:
        return False

    if message_id:
        try:
            await bot.edit_message_text(
                chat_id=chat_id,
                message_id=message_id,
                text=text,
                reply_markup=keyboard,
                link_preview_options=NO_PREVIEW,
            )

            return True

        except TelegramBadRequest as exc:
            if "message is not modified" in str(exc).lower():
                return True

            logger.warning("Не удалось изменить UI: %s", exc)

        except TelegramAPIError:
            logger.exception("Ошибка редактирования UI")

    try:
        message = await bot.send_message(
            chat_id=chat_id,
            text=text,
            reply_markup=keyboard,
            link_preview_options=NO_PREVIEW,
        )

        await save_ui(state, message)

        return True

    except TelegramAPIError:
        logger.exception("Не удалось показать UI")
        return False


async def safe_answer(
    call: CallbackQuery,
    text=None,
    alert=False,
):
    try:
        await call.answer(
            text=text,
            show_alert=alert,
        )
    except TelegramAPIError:
        pass


async def delete_message(message: Message):
    try:
        await message.delete()
    except TelegramAPIError:
        pass


async def edit_card(message: Message, text: str, keyboard=None):
    try:
        await message.edit_text(
            text,
            reply_markup=keyboard,
            link_preview_options=NO_PREVIEW,
        )

    except TelegramBadRequest as exc:
        if "message is not modified" in str(exc).lower():
            return

        logger.warning("Не удалось изменить карточку: %s", exc)

        try:
            await message.answer(
                text,
                reply_markup=keyboard,
                link_preview_options=NO_PREVIEW,
            )
        except TelegramAPIError:
            logger.exception("Не удалось отправить карточку")

    except TelegramAPIError:
        logger.exception("Ошибка Telegram при редактировании")


