def valid_gift_url(url: str) -> bool:
    try:
        parsed = urlparse(url)

        if parsed.scheme not in ("http", "https"):
            return False

        if parsed.netloc.lower() not in (
            "t.me",
            "www.t.me",
            "telegram.me",
            "www.telegram.me",
        ):
            return False

        return bool(parsed.path.strip("/"))

    except Exception:
        return False


@dp.message(OfferForm.gifts)
async def offer_add_gift(message: Message, state: FSMContext):
    url = (message.text or "").strip()

    await delete_message(message)

    if not valid_gift_url(url):
        data = await state.get_data()
        gifts = data.get("gift_urls", [])

        await render_ui(
            state,
            f"{E_ERROR} <b>Некорректная ссылка</b>\n\n"
            f"Уже добавлено подарков: <b>{len(gifts)}</b>\n\n"
            "Отправьте ссылку на подарок из Telegram.\n"
            "Пример: <code>https://t.me/nft/...</code>",
            gifts_keyboard(),
        )
        return

    data = await state.get_data()
    gifts = list(data.get("gift_urls", []))

    if url in gifts:
        await render_ui(
            state,
            f"{E_DEAL} <b>Этот подарок уже добавлен</b>\n\n"
            f"Количество подарков: <b>{len(gifts)}</b>\n\n"
            "Отправьте другую ссылку или нажмите "
            "«📨 Отправить оффер».",
            gifts_keyboard(),
        )
        return

    if len(gifts) >= 20:
        await render_ui(
            state,
            f"{E_ERROR} <b>Достигнут лимит подарков</b>\n\n"
            "В один оффер можно добавить не более 20 подарков.",
            gifts_keyboard(),
        )
        return

    gifts.append(url)

    await state.update_data(gift_urls=gifts)

    await render_ui(
        state,
        f"{E_DEAL} <b>Подарок добавлен</b>\n\n"
        f"Добавлено подарков: <b>{len(gifts)}</b>\n"
        f"Стоимость оффера: <b>{data['amount']} "
