@dp.callback_query(F.data.startswith("deal:warning_ok:"))
async def deal_warning_ok(call: CallbackQuery):
    offer_id = int(call.data.rsplit(":", 1)[1])
    offer = get_offer(offer_id)

    if offer is None or offer["recipient_id"] != call.from_user.id:
        await safe_answer(call, "Сделка не найдена.", True)
        return

    if offer["status"] != "accepted":
        await safe_answer(call, "Сделка уже обработана.", True)
        return

    deal_code = generate_deal_code()
    update_offer(offer_id, "deal_open", deal_code)

    icon = E_STARS if offer["currency"] == "Stars" else E_GRAM
    sender = get_user(offer["sender_id"])

    buyer = (
        "@" + sender["username"]
        if sender and sender["username"]
        else f"ID {offer['sender_id']}"
    )

    text = (
        "<b>Сделка по NFT</b>\n\n"
        f"Заказ <code>#{deal_code}</code>\n\n"
        f"Стоимость предложения: {offer['amount']} "
        f"{icon} {offer['currency']}.\n\n"
        "<b>Статус:</b> Тестовая сделка открыта.\n"
        "<b>Эскроу:</b> Не подключён. Средства не зарезервированы.\n\n"
        "<b>Инструкция:</b>\n\n"
        f"1. Покупатель: {escape(buyer)}.\n"
        "2. Откройте ссылку на подарок.\n"
        "3. Если хотите продолжить, используйте официальный "
        "интерфейс Telegram для передачи подарка.\n\n"
        f'<a href="{escape(offer["gift_url"], quote=True)}">Открыть подарок</a>\n\n'
        f"{E_CLOCK} Подтверждение в боте не доказывает передачу NFT "
        "и не приводит к автоматическому начислению средств."
    )

    await edit_or_send(
        call.message,
        text,
        deal_keyboard(offer_id),
    )

    await safe_answer(call)

    await notify_user(
        offer["sender_id"],
        f"🧾 Сделка <code>#{deal_code}</code> открыта.\n"
        "Тестовый режим: средства не резервируются.",
        main_keyboard(),
    )


