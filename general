def now_iso():
    return datetime.now(timezone.utc).isoformat()


def register_user(user):
    if not user:
        return

    db.execute("""
        INSERT INTO users (
            user_id, username, first_name, joined_at
        )
        VALUES (?, ?, ?, ?)
        ON CONFLICT(user_id) DO UPDATE SET
            username = excluded.username,
            first_name = excluded.first_name
    """, (
        user.id,
        user.username,
        user.first_name or "",
        now_iso(),
    ))
    db.commit()


def get_user(user_id):
    if not user_id:
        return None

    return db.execute(
        "SELECT * FROM users WHERE user_id = ?",
        (user_id,),
    ).fetchone()


def normalize_username(value):
    value = (value or "").strip()

    value = re.sub(
        r"^https?://(?:www\.)?t\.me/",
        "",
        value,
        flags=re.IGNORECASE,
    )
    value = re.sub(
        r"^(?:www\.)?t\.me/",
        "",
        value,
        flags=re.IGNORECASE,
    )

    value = value.split("/", 1)[0]
    value = value.split("?", 1)[0]
    value = value.lstrip("@").strip()

    return value.lower()


def valid_username(username):
    return bool(
        re.fullmatch(r"[a-zA-Z0-9_]{5,32}", username or "")
    )


def find_user(username):
    normalized = normalize_username(username)

    if not valid_username(normalized):
        return None

    return db.execute("""
        SELECT *
        FROM users
        WHERE username IS NOT NULL
          AND lower(username) = ?
        LIMIT 1
    """, (normalized,)).fetchone()


def create_offer(
    sender_id,
    recipient_username,
    recipient_id,
    currency,
    amount,
    gift_urls,
):
    code = secrets.token_hex(5).upper()

    cursor = db.execute("""
        INSERT INTO offers (
            code, sender_id, recipient_id, recipient_username,
            currency, amount, gift_url, gift_urls,
            status, created_at
        )
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    """, (
        code,
        sender_id,
        int(recipient_id or 0),
        recipient_username,
        currency,
        amount,
        gift_urls[0] if gift_urls else "",
        "\n".join(gift_urls),
        "pending" if recipient_id else "pending_delivery",
        now_iso(),
    ))

    db.commit()
    return code, cursor.lastrowid


def get_offer(offer_id):
    return db.execute(
        "SELECT * FROM offers WHERE id = ?",
        (offer_id,),
    ).fetchone()


def get_gift_urls(offer):
    raw = offer["gift_urls"] or offer["gift_url"] or ""
    return [item.strip() for item in raw.splitlines() if item.strip()]


def update_offer(
    offer_id,
    status,
    deal_code=None,
    reviewed_by=None,
    review_comment=None,
):
    db.execute("""
        UPDATE offers
        SET
            status = ?,
            deal_code = COALESCE(?, deal_code),
            reviewed_by = COALESCE(?, reviewed_by),
            reviewed_at = CASE
                WHEN ? IS NOT NULL THEN ?
                ELSE reviewed_at
            END,
            review_comment = COALESCE(?, review_comment)
        WHERE id = ?
    """, (
        status,
        deal_code,
        reviewed_by,
        reviewed_by,
        now_iso(),
        review_comment,
        offer_id,
    ))
    db.commit()


def generate_deal_code():
    alphabet = string.ascii_uppercase + string.digits

    while True:
        code = "TG-" + "".join(
            secrets.choice(alphabet) for _ in range(8)
        )

        exists = db.execute(
            "SELECT 1 FROM offers WHERE deal_code = ?",
            (code,),
        ).fetchone()

        if not exists:
            return code


def currency_icon(currency):
    for item in CURRENCIES.values():
        if item["name"] == currency:
            return item["emoji"]

    return ""


def display_user(user_id):
    user = get_user(user_id)

    if user and user["username"]:
        return "@" + escape(user["username"])

    return f"ID <code>{user_id}</code>"


