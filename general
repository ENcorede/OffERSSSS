def gen_id(n=8):
    return "TG-" + "".join(random.choices(string.ascii_uppercase + string.digits, k=n))


LANG_PROMPT = "🌐 Choose language / Выберите язык / 选择语言"


async def edit_or_send(message: Message, state: FSMContext, text: str, kb):
    """Редактируем сохранённый промпт, чтобы не плодить сообщения."""
    data = await state.get_data()
    pid = data.get("prompt_msg_id")
    if pid:
        try:
            await message.bot.edit_message_text(
                chat_id=message.chat.id,
                message_id=pid,
                text=text,
                reply_markup=kb,
            )
            return
        except Exception:
            pass
    sent = await message.answer(text, reply_markup=kb)
    await state.update_data(prompt_msg_id=sent.message_id)


async def send_offer_to_recipient(bot_instance, recipient_id, offer_id):
    o = offers[offer_id]
    lang = o.get("lang", get_lang(recipient_id))
    text = t_lang(lang, "offer_to_recipient",
                  amount=o["amount"], currency=o["currency"], link=o["link"])
    kb = InlineKeyboardMarkup(inline_keyboard=[[
        InlineKeyboardButton(
            text=t_lang(lang, "btn_reject"),
            callback_data=f"reject:{offer_id}",
            icon_custom_emoji_id=EMOJI_MAP["✖️"]
        ),
        InlineKeyboardButton(
            text=t_lang(lang, "btn_accept"),
            callback_data=f"accept:{offer_id}",
            icon_custom_emoji_id=EMOJI_MAP["✅"]
        ),
    ]])
    await bot_instance.send_message(recipient_id, e(text), reply_markup=kb)


