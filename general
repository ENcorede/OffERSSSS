@dp.callback_query(F.data == "offer:confirm")
async def offer_confirm(call: CallbackQuery, state: FSMContext):
    if await state.get_state() != OfferForm.confirm.state:
        await safe_answer(
            call,
            "Этап завершён. Начните заново из меню.",
            True,
        )
        return

    data = await state.get_data()
    urls = data.get("gift_urls", [])
    recipient_username = data.get("recipient_username")
    recipient_id = data.get("recipient_id") or 0

    if not recipient_username or not urls:
        await render_ui(
            state,
            "Недостаточно данных для создания оффера.\n\n"
            "Вернитесь в меню и начните заново.",
            main_keyboard(),
        )
        await safe_answer(call, "Недостаточно данных.", True)
        return

    code, offer_id = create_offer(
        call.from_user.id,
        recipient_username,
        recipient_id,
        data["currency"],
        data["amount"],
        urls,
    )

    offer = get_offer(offer_id)
    delivered = False

    if recipient_id:
        try:
            await bot.send_message(
                recipient_id,
                build_recipient_offer_text(offer),
                reply_markup=incoming_keyboard(offer_id),
                link_preview_options=NO_PREVIEW,
            )
            delivered = True

        except TelegramAPIError:
            logger.exception(
                "Не удалось доставить оффер %s получателю %s",
                code,
                recipient_id,
            )
            update_offer(offer_id, "pending_delivery")

    await state.clear()
    await save_ui(state, call.message)

    if not delivered:
        await render_ui(
            state,
            f"{E_CLOCK} <b>Оффер сохранён</b>\n\n"
            f"Номер: <code>{code}</code>\n"
            f"Получатель: @{escape(recipient_username)}\n"
            f"Количество подарков: <b>{len(urls)}</b>\n\n"
            "Получатель ещё не запускал бота либо доставка "
            "пока невозможна.\n\n"
            "Чтобы получить оффер, ему необходимо открыть бота "
            "и нажать «Старт». Оффер сохранён в базе данных.",
            main_keyboard(),
        )

        await safe_answer(call, "Оффер сохранён.")
        return

    await render_ui(
        state,
        f"{E_OFFER_SENT} <b>Оффер отправлен</b>\n\n"
        f"Номер: <code>{code}</code>\n"
        f"Валюта: <b>{escape(data['currency'])}</b>\n"
        f"Стоимость: <b>{data['amount']} "
        f"{data['currency_emoji']}</b>\n"
        f"Количество подарков: <b>{len(urls)}</b>",
        main_keyboard(),
    )

    await safe_answer(call, "Оффер отправлен.")


