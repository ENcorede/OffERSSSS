async def save_ui(state, message):
    await state.update_data(
        ui_chat_id=message.chat.id,
        ui_message_id=message.message_id,
    )


async def render_ui(state, text, keyboard=None):
    data = await state.get_data()
    chat_id = data.get("ui_chat_id")
    message_id = data.get("ui_message_id")

    if chat_id and message_id:
        try:
            await bot.edit_message_text(
                chat_id=chat_id,
                message_id=message_id,
                text=text,
                reply_markup=keyboard,
                disable_web_page_preview=True,
            )
            return
        except TelegramBadRequest as exc:
            if "message is not modified" in str(exc).lower():
                return
            logger.warning("Не удалось изменить сообщение: %s", exc)
        except TelegramAPIError:
            logger.exception("Ошибка редактирования сообщения")

    if chat_id:
        try:
            msg = await bot.send_message(
                chat_id,
                text,
                reply_markup=keyboard,
                disable_web_page_preview=True,
            )
            await save_ui(state, msg)
        except TelegramAPIError:
            logger.exception("Не удалось отправить сообщение интерфейса")


async def edit_or_send(message, text, keyboard=None):
    try:
        await message.edit_text(
            text,
            reply_markup=keyboard,
            disable_web_page_preview=True,
        )
    except TelegramBadRequest as exc:
        if "message is not modified" in str(exc).lower():
            return
        try:
            await message.answer(
                text,
                reply_markup=keyboard,
                disable_web_page_preview=True,
            )
        except TelegramAPIError:
            logger.exception("Не удалось отправить сообщение")


async def safe_answer(call, text=None, alert=False):
    try:
        await call.answer(text=text, show_alert=alert)
    except TelegramAPIError:
        pass


async def delete_user_message(message):
    try:
        await message.delete()
    except TelegramAPIError:
        logger.warning("Не удалось удалить сообщение %s", message.message_id)


