        nav_keyboard(),
    )

    await safe_answer(call)


@dp.message(OfferForm.username)
async def offer_username(message: Message, state: FSMContext):
    register_user(message.from_user)

    username = normalize_username(message.text or "")
    await delete_user_message(message)

    if not valid_username(username):
        await render_ui(
            state,
            f"{E_REJECT} <b>Некорректный username</b>\n\n"
            "Введите username длиной от 5 до 32 символов.\n"
            "Пример: <code>@username</code>.",
            nav_keyboard(),
        )
        return

    recipient = find_user(username)
    recipient_id = recipient["user_id"] if recipient else 0

    if recipient_id == message.from_user.id:
        await render_ui(
            state,
            f"{E_REJECT} <b>Нельзя отправить оффер самому себе</b>\n\n"
            "Введите username другого пользователя.",
            nav_keyboard(),
        )
        return

    await state.update_data(
        recipient_id=recipient_id,
        recipient_username=username,
    )

    await state.set_state(OfferForm.currency)

    await render_ui(
        state,
        "<b>Выберите валюту</b>\n\n"
        "Выбранная валюта будет использоваться в оффере "
        "и карточке сделки.",
        currency_keyboard(),
    )


@dp.callback_query(F.data == "back:username")
