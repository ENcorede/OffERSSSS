@dp.callback_query(F.data.startswith("deal:transfer:"))
async def deal_transfer(call: CallbackQuery):
    offer_id = int(call.data.rsplit(":", 1)[1])
    offer = get_offer(offer_id)

    if offer is None or offer["recipient_id"] != call.from_user.id:
        await safe_answer(call, "Сделка не найдена.", True)
        return

    if offer["status"] != "deal_open":
        await safe_answer(
            call,
            "Сделка уже отправлена на проверку или закрыта.",
            True,
        )
        return

    update_offer(offer_id, "review")

    text = (
        "<b>🔎 Передача ожидает проверки</b>\n\n"
        f"Заказ: <code>#{offer['deal_code']}</code>\n"
        f"Стоимость: {offer['amount']} {offer['currency']}\n\n"
        "Статус: <b>Ожидает проверки</b>\n\n"
        "Это демонстрационный статус. Бот не проверяет "
        "фактическую передачу NFT и не выполняет выплаты."
    )

    await edit_or_send(
        call.message,
        text,
        main_keyboard(),
    )

    await safe_answer(
        call,
        "Статус изменён на «Ожидает проверки».",
        True,
    )

    await notify_user(
        offer["sender_id"],
        f"🔎 По сделке <code>#{offer['deal_code']}</code> "
        "установлен статус «Ожидает проверки».\n\n"
        "Передача подарка и оплата автоматически не проверяются.",
        main_keyboard(),
    )


