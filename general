async def deliver_pending_offers(user):
    if not user or not user.username:
        return

    pending = db.execute("""
        SELECT *
        FROM offers
        WHERE status = 'pending_delivery'
          AND lower(recipient_username) = ?
    """, (user.username.lower(),)).fetchall()

    for offer in pending:
        try:
            await bot.send_message(
                user.id,
                recipient_offer_text(offer),
                reply_markup=incoming_keyboard(offer["id"]),
                link_preview_options=NO_PREVIEW,
            )

            db.execute("""
                UPDATE offers
                SET recipient_id = ?, status = 'pending'
                WHERE id = ?
            """, (
                user.id,
                offer["id"],
            ))

            db.commit()

            try:
                await bot.send_message(
                    offer["sender_id"],
                    f"{E_OK} Оффер <code>{offer['code']}</code> "
                    "доставлен получателю.",
                )
            except TelegramAPIError:
                pass

        except TelegramAPIError:
            logger.exception(
                "Не удалось доставить оффер %s",
                offer["code"],
            )


