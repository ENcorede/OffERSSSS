@dp.message(AdminReviewForm.comment)
async def admin_reject_comment(
    message: Message,
    state: FSMContext,
):
    if not message.from_user or message.from_user.id not in ADMIN_IDS:
        await state.clear()
        return

    data = await state.get_data()
    offer_id = data.get("review_offer_id")
    comment = (message.text or "").strip()

    await delete_message(message)

    if not offer_id:
        await state.clear()
        return

    if not comment or len(comment) > 1000:
        await render_ui(
            state,
            f"{E_ERROR} Введите причину длиной от 1 до 1000 символов.",
            back_keyboard(f"admin:reject_empty:{offer_id}"),
        )
        return

    success = await reject_offer_by_admin(
        offer_id,
        message.from_user.id,
        comment,
    )

    await state.clear()

    if success:
        await state.update_data(
            ui_chat_id=message.chat.id,
        )

        result = await message.answer(
            f"{E_OK} Причина сохранена. Сделка отклонена.",
            reply_markup=main_keyboard(),
        )

        await save_ui(state, result)


