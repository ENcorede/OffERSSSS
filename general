    await safe_answer(call)


@dp.message(OfferForm.username)
async def offer_username(message: Message, state: FSMContext):
    register_user(message.from_user)

    username = (message.text or "").strip()
    await delete_user_message(message)

    if not re.fullmatch(r"@?[A-Za-z0-9_]{5,32}", username):
        await update_current_ui(
            state,
            "Некорректный username. Попробуйте ещё раз.",
            exit_keyboard(),
        )
        return

    recipient = find_user(username)

    if recipient is None:
        await update_current_ui(
            state,
            "Пользователь не найден. Попросите его запустить бота.",
            exit_keyboard(),
        )
        return

    if recipient["user_id"] == message.from_user.id:
        await update_current_ui(
            state,
            "Нельзя отправить оффер самому себе.",
            exit_keyboard(),
        )
        return

    await state.update_data(
        recipient_id=recipient["user_id"],
        recipient_username=recipient["username"] or username.lstrip("@"),
    )
    await state.set_state(OfferForm.currency)

    await update_current_ui(
        state,
        f"{E_OFFER} <b>Выберите валюту оффера</b>",
        currency_keyboard(),
    )


async def update_current_ui(state: FSMContext, text, keyboard=None):
    data = await state.get_data()

    chat_id = data.get("ui_chat_id")
    message_id = data.get("ui_message_id")

    if chat_id and message_id:
        edited = await edit_bot_message(
            chat_id,
            message_id,
            text,
            keyboard,
        )

        if edited is not None:
            return

    # Если исходное сообщение недоступно, создаём новое и запоминаем его.
    user_id = data.get("ui_chat_id")

    if user_id:
        try:
            new_message = await bot.send_message(
                user_id,
                text,
                reply_markup=keyboard,
                disable_web_page_preview=True,
            )
            await state.update_data(
                ui_chat_id=new_message.chat.id,
                ui_message_id=new_message.message_id,
            )
        except TelegramBadRequest:
            logger.exception("Не удалось обновить интерфейс")


@dp.callback_query(OfferForm.currency, F.data.startswith("currency:"))
async def offer_currency(call: CallbackQuery, state: FSMContext):
    currencies = {
        "stars": ("Stars", E_STARS),
        "gram": ("Gram", E_GRAM),
        "rub": ("RUB", E_RUB),
        "usd": ("USD", E_USD),
    }

    key = call.data.split(":")[1]
    selected = currencies.get(key)

    if not selected:
        await safe_answer(call, "Неизвестная валюта.", True)
        return

    currency, icon = selected

    await state.update_data(
        currency=currency,
        currency_emoji=icon,
    )
    await state.set_state(OfferForm.amount)

    await edit_or_send(
        call.message,
        f"{icon} <b>Стоимость оффера</b>\n\n"
        f"Введите сумму в валюте {currency}.\n"
        "Например: <code>100</code>",
        exit_keyboard(),
    )

    await state.update_data(
        ui_chat_id=call.message.chat.id,
        ui_message_id=call.message.message_id,
    )

    await safe_answer(call)


@dp.message(OfferForm.amount)
async def offer_amount(message: Message, state: FSMContext):
    value = (message.text or "").strip()
    await delete_user_message(message)

    if not value.isdigit():
        await update_current_ui(
            state,
            "Введите положительное целое число.",
            exit_keyboard(),
        )
        return

    amount = int(value)

    if not 1 <= amount <= 1_000_000_000:
        await update_current_ui(
            state,
            "Сумма должна быть от 1 до 1 000 000 000.",
            exit_keyboard(),
        )
        return

    await state.update_data(amount=amount, gift_urls=[])
    await state.set_state(OfferForm.gifts)

    await update_current_ui(
        state,
        f"{E_OFFER} <b>Добавление подарков</b>\n\n"
        "Отправьте ссылку на первый подарок.\n"
        "После каждой ссылки сообщение со ссылкой будет удаляться.\n\n"
        "Когда закончите, нажмите «Готово».",
        gifts_keyboard(),
    )


@dp.message(OfferForm.gifts)
async def offer_add_gift(message: Message, state: FSMContext):
    url = (message.text or "").strip()

    # Удаляем сообщение со ссылкой, чтобы чат не засорялся.
    await delete_user_message(message)

    if not re.fullmatch(
        r"https?://\S+|(?:t\.me|telegram\.me)/\S+",
        url,
        flags=re.IGNORECASE,
    ):
        await update_gifts_interface(
            state,
            len((await state.get_data()).get("gift_urls", [])),
        )
        return

    if not url.lower().startswith("http"):
        url = "https://" + url

    data = await state.get_data()
    urls = data.get("gift_urls", [])

    if url in urls:
        await update_gifts_interface(state, len(urls))
        return

    if len(urls) >= 20:
        await update_gifts_interface(state, len(urls))
        return

    urls.append(url)
    await state.update_data(gift_urls=urls)

    # Обновляем существующее сообщение интерфейса вместо нового.
    await update_gifts_interface(state, len(urls))


@dp.callback_query(F.data == "gifts:done")
async def offer_gifts_done(call: CallbackQuery, state: FSMContext):
    if await state.get_state() != OfferForm.gifts.state:
        await safe_answer(call, "Сессия истекла.", True)
        return

    data = await state.get_data()
    urls = data.get("gift_urls", [])

    if not urls:
        await safe_answer(call, "Добавьте хотя бы один подарок.", True)
        return

    await state.set_state(OfferForm.confirm)

    text = (
        f"{E_OFFER} <b>Подтверждение оффера</b>\n\n"
        f"Получатель: @{escape(data['recipient_username'])}\n"
        f"Стоимость: {data['amount']} "
        f"{data['currency_emoji']} {data['currency']}\n\n"
        f"<b>Подарки ({len(urls)}):</b>\n"
        f"{gift_list_html(urls)}\n\n"
        "Проверьте данные перед отправкой."
    )

    await edit_or_send(
        call.message,
        text,
        confirm_offer_keyboard(),
    )

    await state.update_data(
        ui_chat_id=call.message.chat.id,
        ui_message_id=call.message.message_id,
    )

    await safe_answer(call)


@dp.callback_query(F.data == "offer:confirm")
async def offer_confirm(call: CallbackQuery, state: FSMContext):
    if await state.get_state() != OfferForm.confirm.state:
        await safe_answer(
            call,
            "Сессия истекла. Создайте оффер заново.",
            True,
        )
        return

    data = await state.get_data()
    recipient = get_user(data["recipient_id"])
    urls = data.get("gift_urls", [])

    if recipient is None or not urls:
        await safe_answer(call, "Не удалось создать оффер.", True)
        return

    code, offer_id = create_offer(
        call.from_user.id,
        recipient,
        data["currency"],
        data["amount"],
        urls,
    )

    sender = (
        "@" + escape(call.from_user.username)
        if call.from_user.username
        else f"ID <code>{call.from_user.id}</code>"
    )

    text = (
        f"{E_OFFER} <b>Вам поступило предложение!</b>\n\n"
        f"Пользователь: {sender}\n"
        f"Стоимость: {data['amount']} "
        f"{data['currency_emoji']} {data['currency']}\n\n"
        f"<b>Подарки ({len(urls)}):</b>\n"
        f"{gift_list_html(urls)}\n\n"
        f"Номер оффера: <code>{code}</code>"
    )

    delivered = await notify_user(
        recipient["user_id"],
        text,
        incoming_offer_keyboard(offer_id),
    )

    await state.clear()

    if not delivered:
        update_offer(offer_id, "delivery_failed")

        await edit_or_send(
            call.message,
            f"{E_REJECT} Не удалось доставить оффер.\n"
            "Получатель должен запустить бота.",
            main_keyboard(),
        )
        await safe_answer(call)
        return

    # Только главное меню. Кнопки повторного предложения нет.
    await edit_or_send(
        call.message,
        f"{E_ACCEPT} <b>Оффер отправлен</b>\n\n"
        f"Номер: <code>{code}</code>\n"
        f"Количество подарков: <b>{len(urls)}</b>",
        main_keyboard(),
    )

    await safe_answer(call)


