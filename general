@dp.message(CommandStart())
async def start(message: Message, state: FSMContext):
    register_user(message.from_user)

    data = await state.get_data()

    # Сохраняем ссылку на прежнее меню до очистки FSM.
    old_chat_id = data.get("ui_chat_id")
    old_message_id = data.get("ui_message_id")

    await state.clear()

    await state.update_data(
        ui_chat_id=old_chat_id or message.chat.id,
        ui_message_id=old_message_id,
    )

    try:
        await deliver_pending_offers(message.from_user)
    except Exception:
        logger.exception("Ошибка доставки отложенных офферов")

    # Само сообщение /start не удаляем.
    # Перед меню отправляем указанное custom emoji.
    try:
        await bot.send_message(
            message.chat.id,
            E_START,
        )
    except TelegramAPIError:
        logger.exception("Не удалось отправить стартовую иконку")

    data = await state.get_data()

    if data.get("ui_message_id"):
        # Используем прежнее меню, не создавая второе.
        await render_ui(
            state,
            main_menu_text(),
            main_keyboard(),
        )
    else:
        menu = await bot.send_message(
            message.chat.id,
            main_menu_text(),
            reply_markup=main_keyboard(),
            link_preview_options=NO_PREVIEW,
        )
        await save_ui(state, menu)


@dp.message(Command("cancel"))
async def cancel_command(message: Message, state: FSMContext):
    await delete_user_message(message)

    data = await state.get_data()

    await state.clear()

    await state.update_data(
        ui_chat_id=data.get("ui_chat_id") or message.chat.id,
        ui_message_id=data.get("ui_message_id"),
    )

    await show_menu(state, message.chat.id)


@dp.callback_query(F.data == "nav:menu")
async def go_menu(call: CallbackQuery, state: FSMContext):
    data = await state.get_data()

    await state.clear()

    # Сохраняем именно то сообщение, с которого нажали кнопку.
    await save_ui(state, call.message)

    await show_menu(state, call.message.chat.id)
    await safe_answer(call)


