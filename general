@dp.callback_query(
    OfferForm.currency,
    F.data.startswith("currency:"),
)
async def offer_currency(call: CallbackQuery, state: FSMContext):
    key = call.data.split(":", 1)[1]
    selected = CURRENCIES.get(key)

    if not selected:
        await safe_answer(call, "Неизвестная валюта.", True)
        return

    currency, icon, _ = selected

    await state.update_data(
        currency=currency,
        currency_emoji=icon,
