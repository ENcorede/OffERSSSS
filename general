async def edit_bot_message(chat_id, message_id, text, keyboard=None):
    """Редактирует сохранённое сообщение интерфейса."""
    try:
        return await bot.edit_message_text(
            chat_id=chat_id,
            message_id=message_id,
            text=text,
            reply_markup=keyboard,
            disable_web_page_preview=True,
        )
    except TelegramBadRequest as exc:
        if "message is not modified" in str(exc).lower():
            return None

        logger.warning("Не удалось отредактировать сообщение: %s", exc)
        return None


async def edit_or_send(message, text, keyboard=None):
    try:
        return await message.edit_text(
            text,
            reply_markup=keyboard,
            disable_web_page_preview=True,
        )
    except TelegramBadRequest as exc:
        if "message is not modified" in str(exc).lower():
            return message

        return await message.answer(
            text,
            reply_markup=keyboard,
            disable_web_page_preview=True,
        )


async def safe_answer(call, text=None, alert=False):
    try:
        await call.answer(text=text, show_alert=alert)
    except TelegramBadRequest:
        pass


async def notify_user(user_id, text, keyboard=None):
    try:
        await bot.send_message(
            user_id,
            text,
            reply_markup=keyboard,
            disable_web_page_preview=True,
        )
        return True
    except (TelegramForbiddenError, TelegramBadRequest):
        logger.warning("Не удалось уведомить пользователя %s", user_id)
        return False


async def delete_user_message(message: Message):
    try:
        await message.delete()
    except TelegramBadRequest:
        # Удаление может быть недоступно, например из-за ограничений чата.
        pass


async def update_gifts_interface(state: FSMContext, count: int):
    data = await state.get_data()

    chat_id = data.get("ui_chat_id")
    message_id = data.get("ui_message_id")

    if not chat_id or not message_id:
        return

    text = (
        f"{E_OFFER} <b>Добавление подарков</b>\n\n"
        f"Добавлено подарков: <b>{count}</b>\n\n"
        "Отправьте следующую ссылку или нажмите «Готово»."
    )

    await edit_bot_message(
        chat_id,
        message_id,
        text,
        gifts_keyboard(),
    )


