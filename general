        "Создавайте предложения и отслеживайте сделки.",
        main_keyboard(),
    )


# ========================= СТАРТ =========================

@dp.message(CommandStart())
async def start(message: Message, state: FSMContext):
    register_user(message.from_user)
    await state.clear()

    try:
        await message.answer(E_START)
    except TelegramAPIError:
        try:
            await message.answer("✨")
        except TelegramAPIError:
            pass

    menu = await message.answer(
        f"{E_MENU} <b>Telegram Offers</b>\n\n"
        "Создавайте предложения и отслеживайте сделки.",
        reply_markup=main_keyboard(),
    )
    await save_ui(state, menu)


@dp.message(Command("cancel"))
async def cancel_command(message: Message, state: FSMContext):
    await delete_user_message(message)

    data = await state.get_data()
    await state.clear()

    await state.update_data(
        ui_chat_id=data.get("ui_chat_id"),
        ui_message_id=data.get("ui_message_id"),
    )

    await show_menu(state)


@dp.callback_query(F.data == "nav:menu")
async def go_menu(call: CallbackQuery, state: FSMContext):
    await state.clear()
    await save_ui(state, call.message)
    await show_menu(state)
    await safe_answer(call)


