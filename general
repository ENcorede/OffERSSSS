@dp.message(CommandStart())
async def cmd_start(message: Message, state: FSMContext):
    await state.clear()
    started_users.add(message.from_user.id)
    if message.from_user.username:
        username_to_id[message.from_user.username.lower()] = message.from_user.id

    # Первый запуск — просим выбрать язык
    if message.from_user.id not in user_langs:
        await message.answer(LANG_PROMPT, reply_markup=language_kb())
        return

    uid = message.from_user.id
    await message.answer(e("🔷"))
    await message.answer(e(t(uid, "welcome")), reply_markup=main_menu_kb(uid))

    if message.from_user.username:
        u = message.from_user.username.lower()
        if u in pending_offers:
            for oid in list(pending_offers[u]):
                if oid in offers and offers[oid]["status"] == "pending":
                    await send_offer_to_recipient(bot, message.from_user.id, oid)
            pending_offers.pop(u, None)


@dp.callback_query(F.data.startswith("lang:"))
async def cb_lang(cb: CallbackQuery, state: FSMContext):
    code = cb.data.split(":", 1)[1]
    if code not in LANGUAGES:
        await cb.answer()
        return
    is_first = cb.from_user.id not in user_langs
    user_langs[cb.from_user.id] = code
    started_users.add(cb.from_user.id)
    if cb.from_user.username:
        username_to_id[cb.from_user.username.lower()] = cb.from_user.id

    uid = cb.from_user.id
    await cb.message.edit_text(e(t(uid, "welcome")), reply_markup=main_menu_kb(uid))
    await cb.answer(t(uid, "language_changed"))

    if is_first and cb.from_user.username:
        u = cb.from_user.username.lower()
        if u in pending_offers:
            for oid in list(pending_offers[u]):
                if oid in offers and offers[oid]["status"] == "pending":
                    await send_offer_to_recipient(bot, uid, oid)
            pending_offers.pop(u, None)


