async def reject_offer_by_admin(
    offer_id: int,
    admin_id: int,
    comment: str = "",
):
    offer = get_offer(offer_id)

    if not offer or offer["status"] != "review":
        return False

    db.execute("""
        UPDATE offers
        SET status = 'rejected_review',
            reviewed_by = ?,
            reviewed_at = ?,
            review_comment = ?
        WHERE id = ? AND status = 'review'
    """, (
        admin_id,
        now_iso(),
        comment or None,
        offer_id,
    ))

    db.commit()

    text = (
        f"{E_ERROR} <b>Сделка отклонена администрацией</b>\n\n"
        f"Код: <code>{offer['deal_code']}</code>"
    )

    if comment:
        text += f"\nПричина: {escape(comment)}"

    for user_id in (offer["sender_id"], offer["recipient_id"]):
        try:
            await bot.send_message(user_id, text)
        except TelegramAPIError:
            pass

    return True


