@dp.message(OfferForm.username)
async def offer_username(
    message: Message,
    state: FSMContext,
):
    register_user(message.from_user)

    username = (message.text or "").strip()

    if not re.fullmatch(
        r"@?[A-Za-z0-9_]{5,32}",
        username,
    ):
        await message.answer(
            "Некорректный username. Попробуйте ещё раз.",
            reply_markup=exit_keyboard(),
        )
        return

    recipient = find_user(username)

    if recipient is None:
        await message.answer(
            "Пользователь не найден.\n\n"
            "Попросите его открыть бота и нажать /start.",
            reply_markup=exit_keyboard(),
        )
        return

    if recipient["user_id"] == message.from_user.id:
        await message.answer(
            "Нельзя отправить оффер самому себе.",
            reply_markup=exit_keyboard(),
        )
        return

    await state.update_data(
        recipient_id=recipient["user_id"],
        recipient_username=(
            recipient["username"] or username.lstrip("@")
        ),
    )

    await state.set_state(OfferForm.currency)

    await message.answer(
        f"{E_OFFER} <b>Выберите валюту оффера</b>",
        reply_markup=currency_keyboard(),
    )


@dp.callback_query(
    OfferForm.currency,
    F.data.startswith("currency:"),
)
async def offer_currency(
    call: CallbackQuery,
    state: FSMContext,
):
    currency_key = call.data.split(":")[1]

    if currency_key == "stars":
        currency = "Stars"
        icon = E_STARS

    elif currency_key == "gram":
        currency = "Gram"
        icon = E_GRAM

    else:
        await safe_answer(
            call,
            "Неизвестная валюта.",
            True,
        )
        return

    await state.update_data(
        currency=currency,
        currency_emoji=icon,
    )

    await state.set_state(OfferForm.amount)

    await edit_or_send(
        call.message,
        f"{icon} <b>Стоимость оффера</b>\n\n"
        f"Введите целое количество {currency}.\n"
        "Например: <code>100</code>",
        exit_keyboard(),
    )

    await safe_answer(call)


@dp.message(OfferForm.amount)
async def offer_amount(
    message: Message,
    state: FSMContext,
):
    value = (message.text or "").strip()

    if not value.isdigit():
        await message.answer(
            "Введите положительное целое число.",
            reply_markup=exit_keyboard(),
        )
        return

    amount = int(value)

    if not 1 <= amount <= 1_000_000_000:
        await message.answer(
            "Сумма должна быть от 1 до 1 000 000 000.",
            reply_markup=exit_keyboard(),
        )
        return

    await state.update_data(amount=amount)
    await state.set_state(OfferForm.gift_url)

    await message.answer(
        f"{E_OFFER} <b>Ссылка на подарок</b>\n\n"
        "Отправьте ссылку на подарок Telegram.",
        reply_markup=exit_keyboard(),
    )


@dp.message(OfferForm.gift_url)
async def offer_gift_url(
    message: Message,
    state: FSMContext,
):
    url = (message.text or "").strip()

    if not re.fullmatch(
        r"https?://\S+|(?:t\.me|telegram\.me)/\S+",
        url,
        flags=re.IGNORECASE,
    ):
        await message.answer(
            "Отправьте корректную ссылку на подарок.",
            reply_markup=exit_keyboard(),
        )
        return

    if not url.lower().startswith("http"):
        url = "https://" + url

    await state.update_data(gift_url=url)
    await state.set_state(OfferForm.confirm)

    data = await state.get_data()

    text = (
        f"{E_OFFER} <b>Подтверждение оффера</b>\n\n"
        f"Получатель: @{escape(data['recipient_username'])}\n"
        f"Стоимость: {data['amount']} "
        f"{data['currency_emoji']} {data['currency']}\n"
        f"Подарок: <a href=\"{escape(url, quote=True)}\">"
        "Открыть подарок</a>\n\n"
        "Проверьте данные перед отправкой предложения."
    )

    await message.answer(
        text,
        reply_markup=confirm_offer_keyboard(),
        disable_web_page_preview=True,
    )


@dp.callback_query(F.data == "offer:confirm")
async def offer_confirm(
    call: CallbackQuery,
    state: FSMContext,
):
    if await state.get_state() != OfferForm.confirm.state:
        await safe_answer(
            call,
            "Сессия истекла. Создайте оффер заново.",
            True,
        )
        return

    data = await state.get_data()
    recipient = get_user(data["recipient_id"])

    if recipient is None:
        await state.clear()
        await safe_answer(
            call,
            "Получатель не найден.",
            True,
        )
        return

    code, offer_id = create_offer(
        sender_id=call.from_user.id,
        recipient=recipient,
        currency=data["currency"],
        amount=data["amount"],
        gift_url=data["gift_url"],
    )

    await state.clear()

    sender_username = call.from_user.username

    sender = (
        "@" + escape(sender_username)
        if sender_username
        else f"ID <code>{call.from_user.id}</code>"
    )

    text = (
        f"{E_OFFER} <b>Вам поступило предложение!</b>\n\n"
        f"Пользователь {sender} предлагает "
        f"{data['amount']} {data['currency_emoji']} "
        f"{data['currency']} за подарок:\n"
        f'<a href="{escape(data["gift_url"], quote=True)}">'
        "Открыть подарок</a>\n\n"
        f"Номер оффера: <code>{code}</code>\n\n"
        "Вы можете принять или отклонить предложение."
    )

    delivered = await notify_user(
        recipient["user_id"],
        text,
        incoming_offer_keyboard(offer_id),
    )

    if not delivered:
        update_offer(offer_id, "delivery_failed")

        await edit_or_send(
            call.message,
            f"{E_REJECT} <b>Не удалось доставить оффер</b>\n\n"
            "Получатель должен открыть бота и нажать /start.",
            main_keyboard(),
        )

        await safe_answer(call)
        return

    await edit_or_send(
        call.message,
        f"{E_ACCEPT} <b>Оффер отправлен</b>\n\n"
        f"Номер: <code>{code}</code>\n"
        f"Получатель: @{escape(data['recipient_username'])}",
        main_keyboard(),
    )

    await safe_answer(call)


# ============================================================
# REJECT OFFER
# ============================================================

@dp.callback_query(F.data.startswith("incoming:reject:"))
async def reject_offer(call: CallbackQuery):
    try:
        offer_id = int(call.data.rsplit(":", 1)[1])
    except (ValueError, IndexError):
        await safe_answer(call, "Некорректный оффер.", True)
        return

    offer = get_offer(offer_id)

    if offer is None or offer["recipient_id"] != call.from_user.id:
        await safe_answer(call, "Оффер не найден.", True)
        return

    if offer["status"] != "pending":
        await safe_answer(call, "Оффер уже обработан.", True)
        return

    update_offer(offer_id, "rejected")

    await edit_or_send(
        call.message,
        f"{E_REJECT} <b>Предложение отклонено</b>",
        main_keyboard(),
    )

    await notify_user(
        offer["sender_id"],
        f"{E_REJECT} Ваш оффер <code>{offer['code']}</code> отклонён.",
        main_keyboard(),
    )

    await safe_answer(call)


