db = sqlite3.connect(DB_PATH)
db.row_factory = sqlite3.Row

db.execute("""
CREATE TABLE IF NOT EXISTS users (
    user_id INTEGER PRIMARY KEY,
    username TEXT,
    first_name TEXT,
    joined_at TEXT NOT NULL
)
""")

db.execute("""
CREATE TABLE IF NOT EXISTS offers (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    code TEXT UNIQUE NOT NULL,
    sender_id INTEGER NOT NULL,
    recipient_id INTEGER NOT NULL,
    recipient_username TEXT,
    currency TEXT NOT NULL,
    amount INTEGER NOT NULL,
    gift_url TEXT NOT NULL DEFAULT '',
    gift_urls TEXT NOT NULL DEFAULT '',
    status TEXT NOT NULL DEFAULT 'pending',
    deal_code TEXT UNIQUE,
    created_at TEXT NOT NULL,
    reviewed_by INTEGER,
    reviewed_at TEXT,
    review_comment TEXT
)
""")

columns = {
    row["name"]
    for row in db.execute("PRAGMA table_info(offers)").fetchall()
}

migrations = {
    "gift_urls": "TEXT NOT NULL DEFAULT ''",
    "reviewed_by": "INTEGER",
    "reviewed_at": "TEXT",
    "review_comment": "TEXT",
}

for column, declaration in migrations.items():
    if column not in columns:
        db.execute(
            f"ALTER TABLE offers ADD COLUMN {column} {declaration}"
        )

# Миграция старых офферов с одной ссылкой.
db.execute("""
UPDATE offers
SET gift_urls = gift_url
WHERE (gift_urls IS NULL OR gift_urls = '')
  AND gift_url IS NOT NULL
  AND gift_url != ''
""")

db.commit()


def now_iso():
    return datetime.now(timezone.utc).isoformat()


def register_user(user):
    if user is None:
        return

    db.execute("""
        INSERT INTO users (user_id, username, first_name, joined_at)
        VALUES (?, ?, ?, ?)
        ON CONFLICT(user_id) DO UPDATE SET
            username = excluded.username,
            first_name = excluded.first_name
    """, (
        user.id,
        user.username,
        user.first_name or "",
        now_iso(),
    ))
    db.commit()


def get_user(user_id):
    return db.execute(
        "SELECT * FROM users WHERE user_id = ?",
        (user_id,),
    ).fetchone()


def find_user(username):
    username = username.strip().lstrip("@").lower()

    return db.execute("""
        SELECT * FROM users
        WHERE lower(username) = ?
        LIMIT 1
    """, (username,)).fetchone()


def create_offer(sender_id, recipient, currency, amount, gift_urls):
    code = secrets.token_hex(5).upper()

    cursor = db.execute("""
        INSERT INTO offers (
            code, sender_id, recipient_id, recipient_username,
            currency, amount, gift_url, gift_urls, status, created_at
        )
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, 'pending', ?)
    """, (
        code,
        sender_id,
        recipient["user_id"],
        recipient["username"],
        currency,
        amount,
        gift_urls[0],
        "\n".join(gift_urls),
        now_iso(),
    ))

    db.commit()
    return code, cursor.lastrowid


def get_offer(offer_id):
    return db.execute(
        "SELECT * FROM offers WHERE id = ?",
        (offer_id,),
    ).fetchone()


def get_gift_urls(offer):
    raw = offer["gift_urls"] or offer["gift_url"] or ""
    return [url.strip() for url in raw.splitlines() if url.strip()]


def update_offer(
    offer_id,
    status,
    deal_code=None,
    reviewed_by=None,
    review_comment=None,
):
    db.execute("""
        UPDATE offers
        SET status = ?,
            deal_code = COALESCE(?, deal_code),
            reviewed_by = COALESCE(?, reviewed_by),
            reviewed_at = CASE
                WHEN ? IS NOT NULL THEN ?
                ELSE reviewed_at
            END,
            review_comment = COALESCE(?, review_comment)
        WHERE id = ?
    """, (
        status,
        deal_code,
        reviewed_by,
        reviewed_by,
        now_iso(),
        review_comment,
        offer_id,
    ))
    db.commit()


def generate_deal_code():
    alphabet = string.ascii_uppercase + string.digits

    while True:
        code = "TG-" + "".join(
            secrets.choice(alphabet) for _ in range(8)
        )

        exists = db.execute(
            "SELECT 1 FROM offers WHERE deal_code = ?",
            (code,),
        ).fetchone()

        if not exists:
            return code


