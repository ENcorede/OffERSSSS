async def finalize_admin_rejection(
    offer_id: int,
    admin_id: int,
    comment: str = "",
):
    offer = get_offer(offer_id)

    if offer is None or offer["status"] != "review":
        return False

    update_offer(
        offer_id,
        "rejected_review",
        reviewed_by=admin_id,
        review_comment=comment or None,
    )

    text = (
        f"{E_REJECT} <b>Сделка отклонена после проверки</b>\n\n"
        f"Заказ: <code>#{offer['deal_code']}</code>\n\n"
        "Администраторы отклонили заявку."
    )

    if comment:
        text += f"\n\nПричина: {escape(comment)}"

    await notify_user(
        offer["sender_id"],
        text,
        main_keyboard(),
    )

    await notify_user(
        offer["recipient_id"],
        text,
        main_keyboard(),
    )

    return True


