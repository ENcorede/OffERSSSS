@dp.message(F.text)
async def handle_text(message: Message):
    user_id = message.from_user.id

    register_user(message.from_user)

    text = message.text.strip()
    state, data = get_state(user_id)

    # ---------------- ADMIN COMMANDS ----------------
    if text.startswith("/"):
        return

    if not state:
        return

    if not has_access(user_id):
        clear_state(user_id)
        await message.answer(
            "У вас нет доступа к созданию офферов."
        )
        return

    if state == "recipient":
        username = text.strip()

        if not username.startswith("@"):
            username = "@" + username

        recipient = resolve_username(username)

        if not recipient:
            await message.answer(
                "Не удалось найти этого пользователя в базе бота.\n\n"
                "Проверьте username. Пользователь должен хотя бы "
                "один раз запустить бота, чтобы бот мог определить "
                "его Telegram ID."
            )
            return

        if recipient["user_id"] == user_id:
            await message.answer(
                "Нельзя отправить оффер самому себе."
            )
            return

        data["buyer_id"] = recipient["user_id"]
        data["buyer_username"] = recipient["username"]

        set_state(user_id, "gifts", data)

        await message.answer(
            f"{pe('calendar')} Пришлите ссылку на подарок "
            "/ подарки (если несколько — запишите в столбик).",
            reply_markup=back_keyboard(),
        )
        return

    if state == "gifts":
        links = [
            line.strip()
            for line in text.splitlines()
            if line.strip()
        ]

        if not links:
            await message.answer(
                "Пришлите хотя бы одну ссылку на подарок."
            )
            return

        invalid = [
            link for link in links
            if not re.match(
                r"^(https?://)?t\.me/nft/\S+$",
                link,
                re.IGNORECASE,
            )
        ]

        if invalid:
            await message.answer(
                "Некоторые ссылки не похожи на ссылки "
                "Telegram NFT вида t.me/nft/Название.\n"
                "Проверьте ссылки и отправьте список заново."
            )
            return

        normalized = []

        for link in links:
            link = re.sub(
                r"^https?://",
                "",
                link,
                flags=re.IGNORECASE,
            )
            normalized.append("https://" + link)

        data["gift_links"] = normalized

        set_state(user_id, "currency", data)

        await message.answer(
            f"{pe('question')} В какой валюте проводим сделку?",
            reply_markup=currency_keyboard(),
        )
        return

    if state == "amount":
        if not re.fullmatch(r"[0-9]+", text):
            await message.answer(
                "Введите сумму целым положительным числом."
            )
            return

        amount = int(text)

        if amount <= 0:
            await message.answer(
                "Сумма должна быть больше нуля."
            )
            return

        if amount > 10**12:
            await message.answer(
                "Сумма слишком большая."
            )
            return

        data["amount"] = amount

        set_state(user_id, "preview", data)

        currency = currency_data(data["currency"])
        links = "\n".join(data["gift_links"])

        await message.answer(
            f"{pe('plane')} <b>Оффер готов к отправке</b>\n\n"
            "Чтобы отправить, нажмите кнопку ниже. "
            "Если вы не готовы или передумали — не нажимайте.\n\n"
            f"<b>Получатель:</b> "
            f"@{escape(data['buyer_username'] or '')}\n"
            f"<b>Сумма:</b> "
            f"{format_amount(amount)} {currency['premium']}\n"
            f"<b>Подарки:</b>\n{escape(links)}",
            reply_markup=confirm_offer_keyboard(),
            link_preview_options=LinkPreviewOptions(
                is_disabled=True
            ),
        )
        return


