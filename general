user_langs: dict = {}


def get_lang(uid) -> str:
    return user_langs.get(uid, "ru")


def t_lang(lang: str, key: str, **kwargs) -> str:
    text = TEXTS.get(lang, TEXTS["ru"]).get(key)
    if text is None:
        text = TEXTS["ru"].get(key, key)
    if kwargs:
        try:
            text = text.format(**kwargs)
        except (KeyError, IndexError):
            pass
    return text


def t(uid, key: str, **kwargs) -> str:
    return t_lang(get_lang(uid), key, **kwargs)


