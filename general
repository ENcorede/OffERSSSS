async def send_offer_to_buyer(offer_id: int):
    offer = db.execute(
        "SELECT * FROM offers WHERE id=?",
        (offer_id,),
    ).fetchone()

    if not offer or offer["status"] != "pending":
        return

    buyer_id = offer["buyer_id"]
    seller_id = offer["seller_id"]

    seller = get_user(seller_id)
    currency = currency_data(offer["currency"])

    links = offer["gift_links"].splitlines()
    gift_text = "\n".join(
        f"• {escape(link)}"
        for link in links
    )

    seller_name = (
        "@" + escape(seller["username"])
        if seller and seller["username"]
        else f'<a href="tg://user?id={seller_id}">Пользователь</a>'
    )

    text = (
        f"<b>Новое предложение</b>\n\n"
        f"{seller_name} предлагает вам "
        f"<b>{format_amount(offer['amount'])} "
        f"{currency['premium']}</b> за подарок:\n\n"
        f"{gift_text}\n\n"
        "Выберите действие."
    )

    try:
        await bot.send_message(
            buyer_id,
            text,
            reply_markup=recipient_keyboard(offer_id),
            link_preview_options=LinkPreviewOptions(
                is_disabled=True
            ),
        )
    except TelegramForbiddenError:
        # Бот не может написать пользователю, пока тот
        # не запустил бота. Уведомление остаётся в БД.
        return


