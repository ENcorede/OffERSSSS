@dp.callback_query(F.data.startswith("currency:"))
async def callback_currency(call: CallbackQuery):
    user_id = call.from_user.id
    state, data = get_state(user_id)

    if state != "currency":
        await call.answer(
            "Этап создания оффера уже изменился.",
            show_alert=True,
        )
        return

    currency = call.data.split(":", 1)[1]

    if currency not in CURRENCIES:
        await call.answer("Неизвестная валюта.", show_alert=True)
        return

    data["currency"] = currency

    set_state(user_id, "amount", data)

    await call.answer()

    await show_step(
        call.message,
        f"{pe('wallet')} Укажите сумму сделки. "
        "Убедитесь, что она соответствует вашим "
        "возможностям и лимитам по выбранной валюте.",
        back_keyboard(),
    )


