@dp.callback_query(F.data.startswith("admin:reject:"))
async def admin_reject(call: CallbackQuery, state: FSMContext):
    if call.from_user.id not in ADMIN_IDS:
        await safe_answer(call, "Недостаточно прав.", True)
        return

    offer_id = int(call.data.rsplit(":", 1)[1])
    offer = get_offer(offer_id)

    if not offer or offer["status"] != "review":
        await safe_answer(call, "Заявка уже обработана.", True)
        return

    await state.clear()
    await state.set_state(AdminReviewForm.comment)
    await state.update_data(review_offer_id=offer_id)
    await save_ui(state, call.message)

    await render_ui(
        state,
        f"{E_REJECT} <b>Отклонение сделки</b>\n\n"
        f"Заказ: <code>#{offer['deal_code']}</code>\n\n"
        "Отправьте причину следующим сообщением.",
        admin_reject_keyboard(offer_id),
    )

    await safe_answer(call)


async def finalize_rejection(offer_id, admin_id, comment=""):
    offer = get_offer(offer_id)

    if not offer or offer["status"] != "review":
        return False

    update_offer(
        offer_id,
        "rejected_review",
        reviewed_by=admin_id,
        review_comment=comment or None,
    )

    text = (
        f"{E_REJECT} <b>Сделка отклонена</b>\n\n"
        f"Заказ: <code>#{offer['deal_code']}</code>"
    )

    if comment:
        text += f"\n\nПричина: {escape(comment)}"

    for user_id in (offer["sender_id"], offer["recipient_id"]):
        try:
            await bot.send_message(user_id, text)
        except TelegramAPIError:
            pass

    return True


@dp.callback_query(F.data.startswith("admin:reject_empty:"))
async def admin_reject_empty(call: CallbackQuery, state: FSMContext):
    if call.from_user.id not in ADMIN_IDS:
        await safe_answer(call, "Недостаточно прав.", True)
        return

    offer_id = int(call.data.rsplit(":", 1)[1])

    if not await finalize_rejection(offer_id, call.from_user.id):
        await safe_answer(call, "Заявка уже обработана.", True)
        return

    await state.clear()

    await edit_or_send(
        call.message,
        f"{E_REJECT} <b>Заявка отклонена</b>",
        None,
    )

    await safe_answer(call, "Заявка отклонена.")


@dp.message(AdminReviewForm.comment)
async def admin_rejection_comment(message: Message, state: FSMContext):
    if message.from_user.id not in ADMIN_IDS:
        await state.clear()
        return

    data = await state.get_data()
    offer_id = data.get("review_offer_id")
    comment = (message.text or "").strip()

    await delete_user_message(message)

    if not offer_id:
        await state.clear()
        return

    if not comment:
        await render_ui(
            state,
            "Введите причину текстом.",
            exit_keyboard(),
        )
        return

    if len(comment) > 1000:
        await render_ui(
            state,
            "Причина слишком длинная. Максимум 1000 символов.",
            exit_keyboard(),
        )
        return

    if not await finalize_rejection(
        offer_id,
        message.from_user.id,
        comment,
    ):
        await state.clear()
        return

    offer = get_offer(offer_id)
    await state.clear()

    await bot.send_message(
        message.chat.id,
        f"{E_REJECT} <b>Заявка отклонена</b>\n\n"
        f"Заказ: <code>#{offer['deal_code']}</code>",
        reply_markup=main_keyboard(),
    )


