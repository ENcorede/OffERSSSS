@dp.callback_query(F.data == "offer:confirm")
async def offer_confirm(call: CallbackQuery, state: FSMContext):
    current_state = await state.get_state()

    if current_state != OfferForm.gifts.state:
        await safe_answer(
            call,
            "Создание оффера уже завершено. Начните заново.",
            True,
        )
        return

    data = await state.get_data()

    recipient_username = data.get("recipient_username")
    recipient_id = int(data.get("recipient_id") or 0)
    currency = data.get("currency")
    amount = data.get("amount")
    gifts = data.get("gift_urls", [])

    if not recipient_username or not currency or not amount:
        await safe_answer(
            call,
            "Не хватает данных. Начните создание оффера заново.",
            True,
        )
        return

    if not gifts:
        await safe_answer(
            call,
            "Сначала добавьте хотя бы один подарок.",
            True,
        )
        return

    # Создаём запись до отправки сообщения.
    # Даже если доставка не удалась, оффер не потеряется.
    offer_code = generate_code("OF", 8)

    status = "pending" if recipient_id else "pending_delivery"

    cursor = db.execute("""
        INSERT INTO offers (
            code,
            sender_id,
            recipient_id,
            recipient_username,
            currency,
            amount,
            gift_urls,
            status,
            created_at
        )
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
    """, (
        offer_code,
        call.from_user.id,
        recipient_id,
        recipient_username,
        currency,
        int(amount),
        "\n".join(gifts),
        status,
        now_iso(),
    ))

    offer_id = cursor.lastrowid
    db.commit()

    offer = get_offer(offer_id)
    delivered = False

    # Пытаемся сразу отправить оффер получателю.
    if recipient_id:
        try:
            await bot.send_message(
                recipient_id,
                recipient_offer_text(offer),
                reply_markup=incoming_keyboard(offer_id),
                link_preview_options=NO_PREVIEW,
            )

            delivered = True

        except TelegramAPIError as exc:
            logger.warning(
                "Не удалось доставить оффер %s: %s",
                offer_code,
                exc,
            )

    # Сбрасываем этапы, но сохраняем данные UI.
    await state.clear()

    await state.update_data(
        ui_chat_id=call.message.chat.id,
        ui_message_id=call.message.message_id,
    )

    if delivered:
        result_text = (
            f"{E_OK} <b>Оффер успешно отправлен!</b>\n\n"
            f"Номер оффера: <code>{offer_code}</code>\n"
            f"Получатель: @{escape(recipient_username)}\n"
            f"Стоимость: <b>{amount} "
            f"{get_currency_emoji(currency)} "
            f"{escape(currency)}</b>\n"
            f"Количество подарков: <b>{len(gifts)}</b>\n\n"
            "Оффер доставлен получателю в личные сообщения бота."
        )

    elif recipient_id:
        result_text = (
            f"{E_CLOCK} <b>Оффер сохранён</b>\n\n"
            f"Номер оффера: <code>{offer_code}</code>\n"
            f"Получатель: @{escape(recipient_username)}\n\n"
            "Не удалось отправить оффер в личные сообщения. "
            "Получатель должен открыть бота и нажать «Старт». "
            "После этого попробуйте отправить оффер повторно "
            "через создание нового оффера."
        )

    else:
        result_text = (
            f"{E_CLOCK} <b>Оффер сохранён</b>\n\n"
            f"Номер оффера: <code>{offer_code}</code>\n"
            f"Получатель: @{escape(recipient_username)}\n"
            f"Стоимость: <b>{amount} "
            f"{get_currency_emoji(currency)} "
            f"{escape(currency)}</b>\n\n"
            "Пользователь ещё не запускал этого бота либо "
            "не найден в базе. Telegram не позволяет боту "
            "самостоятельно начать личный диалог с пользователем.\n\n"
            "Попросите получателя открыть бота и нажать «Старт»."
        )

    await render_ui(
        state,
        result_text,
        main_keyboard(),
    )

    await safe_answer(
        call,
        "Оффер обработан.",
    )


