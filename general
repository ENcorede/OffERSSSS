@dp.callback_query(F.data == "offer:confirm")
async def callback_confirm_offer(call: CallbackQuery):
    user_id = call.from_user.id
    state, data = get_state(user_id)

    if state != "preview":
        await call.answer(
            "Оффер не готов к отправке.",
            show_alert=True,
        )
        return

    if not has_access(user_id):
        clear_state(user_id)
        await call.answer(
            "У вас нет доступа к созданию офферов.",
            show_alert=True,
        )
        return

    buyer_id = data.get("buyer_id")
    buyer = get_user(buyer_id) if buyer_id else None

    if not buyer:
        clear_state(user_id)
        await call.answer(
            "Получатель не найден. Создайте оффер заново.",
            show_alert=True,
        )
        return

    public_id = new_public_id()
    timestamp = now()

    cur = execute(
        """
        INSERT INTO offers (
            public_id,
            seller_id,
            buyer_id,
            buyer_username,
            gift_links,
            currency,
            amount,
            status,
            created_at,
            updated_at
        )
        VALUES (?, ?, ?, ?, ?, ?, ?, 'pending', ?, ?)
        """,
        (
            public_id,
            user_id,
            buyer_id,
            buyer["username"],
            "\n".join(data["gift_links"]),
            data["currency"],
            data["amount"],
            timestamp,
            timestamp,
        ),
    )

    offer_id = cur.lastrowid

    execute(
        """
        INSERT OR IGNORE INTO notifications
        (user_id, offer_id, created_at)
        VALUES (?, ?, ?)
        """,
        (buyer_id, offer_id, timestamp),
    )

    clear_state(user_id)

    try:
