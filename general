@dp.callback_query(F.data.startswith("incoming:accept:"))
async def incoming_accept(call: CallbackQuery):
    try:
        offer_id = int(call.data.rsplit(":", 1)[1])
    except (ValueError, IndexError):
        await safe_answer(call, "Некорректный оффер.", True)
        return

    offer = get_offer(offer_id)

    if not offer or offer["recipient_id"] != call.from_user.id:
        await safe_answer(call, "Оффер не найден.", True)
        return

    if offer["status"] != "pending":
        await safe_answer(call, "Оффер уже обработан.", True)
        return

    deal_code = generate_code("ST", 6)

    db.execute("""
        UPDATE offers
        SET status = 'deal_open', deal_code = ?
        WHERE id = ? AND status = 'pending'
    """, (
        deal_code,
        offer_id,
    ))

    db.commit()

    offer = get_offer(offer_id)

    await edit_card(
        call.message,
        deal_text(offer),
        deal_keyboard(offer_id),
    )

    try:
        await bot.send_message(
            offer["sender_id"],
            f"{E_OK} <b>Оффер принят!</b>\n\n"
            f"Код сделки: <code>{deal_code}</code>\n"
            f"Стоимость: <b>{offer['amount']} "
            f"{get_currency_emoji(offer['currency'])} "
            f"{escape(offer['currency'])}</b>",
        )
    except TelegramAPIError:
        pass

    await safe_answer(call, "Оффер принят.")


