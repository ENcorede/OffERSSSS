@dp.message(OfferForm.username)
async def offer_username(message: Message, state: FSMContext):
    register_user(message.from_user)

    username = normalize_username(message.text or "")

    await delete_message(message)

    if not valid_username(username):
        await render_ui(
            state,
            f"{E_ERROR} <b>Некорректный username</b>\n\n"
            "Введите username от 5 до 32 символов.\n"
            "Пример: <code>@username</code>",
            back_keyboard("back:menu"),
        )
        return

    recipient = find_user_by_username(username)

    recipient_id = recipient["user_id"] if recipient else 0

    if recipient_id == message.from_user.id:
        await render_ui(
            state,
            f"{E_ERROR} <b>Нельзя отправить оффер самому себе</b>\n\n"
            "Введите username другого пользователя.",
            back_keyboard("back:menu"),
        )
        return

    await state.update_data(
        recipient_username=username,
        recipient_id=recipient_id,
    )

    await state.set_state(OfferForm.currency)

    await render_ui(
        state,
        "<b>Выберите валюту оффера</b>\n\n"
        "Доступны Stars, Gram, RUB и USD.",
        currency_keyboard(),
    )


