@dp.callback_query(F.data.startswith("incoming:accept:"))
async def accept_offer(call: CallbackQuery):
    offer_id = int(call.data.rsplit(":", 1)[1])
    offer = get_offer(offer_id)

    if offer is None or offer["recipient_id"] != call.from_user.id:
        await safe_answer(call, "Оффер не найден.", True)
        return

    if offer["status"] != "pending":
        await safe_answer(call, "Оффер уже обработан.", True)
        return

    update_offer(offer_id, "accepted")

    warning = (
        "<b>Внимание!</b>\n\n"
        "Следуйте инструкциям, чтобы завершить тестовую сделку.\n\n"
        "Никакие реальные средства не зарезервированы. "
        "Бот не проверяет блокчейн и не гарантирует получение оплаты.\n\n"
        "Нажмите «ОК», если вы прочитали это предупреждение."
    )

    await edit_or_send(
        call.message,
        warning,
        warning_keyboard(offer_id),
    )

    await safe_answer(call)

    await notify_user(
        offer["sender_id"],
        f"✅ Получатель принял ваш оффер <code>{offer['code']}</code>.\n"
        "Сделка перешла в тестовый режим.",
        main_keyboard(),
    )


