async def save_ui(state, message):
    await state.update_data(
        ui_chat_id=message.chat.id,
        ui_message_id=message.message_id,
    )


async def render_ui(state, text, keyboard=None):
    """
    Изменяет существующее сообщение интерфейса.
    Новое сообщение создаётся только если старое нельзя изменить.
    """
    data = await state.get_data()

    chat_id = data.get("ui_chat_id")
    message_id = data.get("ui_message_id")

    if chat_id and message_id:
        try:
            await bot.edit_message_text(
                chat_id=chat_id,
                message_id=message_id,
                text=text,
                reply_markup=keyboard,
                disable_web_page_preview=True,
            )
            return
        except TelegramBadRequest as exc:
            if "message is not modified" in str(exc).lower():
                return
            logger.warning("Редактирование интерфейса не удалось: %s", exc)
        except TelegramAPIError:
            logger.exception("Ошибка Telegram при редактировании интерфейса")

    if chat_id:
        try:
            message = await bot.send_message(
                chat_id,
                text,
                reply_markup=keyboard,
                disable_web_page_preview=True,
            )
            await save_ui(state, message)
        except TelegramAPIError:
            logger.exception("Не удалось отправить интерфейс")


async def delete_user_message(message):
    try:
        await message.delete()
    except TelegramAPIError:
        logger.warning(
            "Не удалось удалить сообщение пользователя %s",
            message.message_id,
        )


async def update_gifts_ui(state):
    data = await state.get_data()
    urls = data.get("gift_urls", [])

    await render_ui(
        state,
        f"{E_OFFER} <b>Добавление подарков</b>\n\n"
        f"Добавлено подарков: <b>{len(urls)}</b>\n\n"
        "Отправьте следующую ссылку или нажмите «Готово».",
        gifts_keyboard(),
    )


async def show_menu(state, chat_id):
    text = (
        f"{E_WELCOME} <b>Telegram Offers</b>\n\n"
        "Создавайте предложения и отслеживайте состояние сделок."
    )

    data = await state.get_data()
    message_id = data.get("ui_message_id")

    if message_id and data.get("ui_chat_id") == chat_id:
        await render_ui(state, text, main_keyboard())
    else:
        message = await bot.send_message(
            chat_id,
            text,
            reply_markup=main_keyboard(),
        )
        await save_ui(state, message)


