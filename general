@dp.message(AdminReviewForm.comment)
async def admin_rejection_comment(
    message: Message,
    state: FSMContext,
):
    if message.from_user.id not in ADMIN_IDS:
        await state.clear()
        return

    data = await state.get_data()
    offer_id = data.get("review_offer_id")

    comment = (message.text or "").strip()

    if not offer_id:
        await state.clear()
        await message.answer(
            "Заявка не найдена.",
            reply_markup=main_keyboard(),
        )
        return

    if len(comment) > 1000:
        await message.answer(
            "Причина слишком длинная. Максимум 1000 символов.",
            reply_markup=exit_keyboard(),
        )
        return

    success = await finalize_admin_rejection(
        offer_id,
        message.from_user.id,
        comment,
    )

    await state.clear()

    if not success:
        await message.answer(
            "Заявка уже обработана.",
            reply_markup=main_keyboard(),
        )
        return

    await message.answer(
        f"{E_REJECT} <b>Заявка отклонена</b>\n\n"
        f"Заказ: <code>#{get_offer(offer_id)['deal_code']}</code>",
        reply_markup=main_keyboard(),
    )


