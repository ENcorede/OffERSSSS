@dp.message(OfferForm.username)
async def offer_username(message: Message, state: FSMContext):
    register_user(message.from_user)
    username = (message.text or "").strip()
    await delete_user_message(message)

    if not re.fullmatch(r"@?[A-Za-z0-9_]{5,32}", username):
        await render_ui(
            state,
            "Некорректный username. Попробуйте ещё раз.",
            navigation_keyboard(),
        )
        return

    recipient = find_user(username)

    if not recipient:
        await render_ui(
            state,
            "Пользователь не найден. Он должен сначала запустить бота.",
            navigation_keyboard(),
        )
        return

    if recipient["user_id"] == message.from_user.id:
        await render_ui(
            state,
            "Нельзя отправить оффер самому себе.",
            navigation_keyboard(),
        )
        return

    await state.update_data(
        recipient_id=recipient["user_id"],
        recipient_username=recipient["username"] or username.lstrip("@"),
    )
    await state.set_state(OfferForm.currency)

    await render_ui(
        state,
        f"{E_OFFER} <b>Выберите валюту</b>\n\n"
        f"{E_STARS} Stars\n"
        f"{E_GRAM} Gram\n"
        f"{E_RUB} RUB\n"
        f"{E_USD} USD",
        navigation_keyboard("back:username"),
    )


