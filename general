def now_iso():
    return datetime.now(timezone.utc).isoformat()


def register_user(user):
    if user is None:
        return

    db.execute("""
        INSERT INTO users (
            user_id,
            username,
            first_name,
            joined_at
        )
        VALUES (?, ?, ?, ?)
        ON CONFLICT(user_id) DO UPDATE SET
            username = excluded.username,
            first_name = excluded.first_name
    """, (
        user.id,
        user.username,
        user.first_name or "",
        now_iso(),
    ))

    db.commit()


def get_user(user_id: int):
    return db.execute(
        "SELECT * FROM users WHERE user_id = ?",
        (user_id,),
    ).fetchone()


def normalize_username(value: str) -> str:
    value = (value or "").strip()

    value = re.sub(
        r"^https?://(?:www\.)?t\.me/",
        "",
        value,
        flags=re.IGNORECASE,
    )

    value = re.sub(
        r"^(?:www\.)?t\.me/",
        "",
        value,
        flags=re.IGNORECASE,
    )

    value = value.split("/", 1)[0]
    value = value.split("?", 1)[0]
    value = value.lstrip("@").strip()

    return value.lower()


def valid_username(username: str) -> bool:
    return bool(
        re.fullmatch(
            r"[a-zA-Z0-9_]{5,32}",
            username or "",
        )
    )


def find_user_by_username(username: str):
    username = normalize_username(username)

    return db.execute("""
        SELECT *
        FROM users
        WHERE username IS NOT NULL
          AND lower(username) = ?
        LIMIT 1
    """, (username,)).fetchone()


def generate_code(prefix="OF", length=8):
    alphabet = string.ascii_uppercase + string.digits

    while True:
        code = prefix + "-" + "".join(
            secrets.choice(alphabet)
            for _ in range(length)
        )

        exists = db.execute("""
            SELECT 1 FROM offers
            WHERE code = ? OR deal_code = ?
        """, (code, code)).fetchone()

        if not exists:
            return code


def get_offer(offer_id: int):
    return db.execute(
        "SELECT * FROM offers WHERE id = ?",
        (offer_id,),
    ).fetchone()


def get_offer_gifts(offer):
    raw = offer["gift_urls"] or ""

    return [
        url.strip()
        for url in raw.splitlines()
        if url.strip()
    ]


def gift_links_html(urls):
    result = []

    for index, url in enumerate(urls, 1):
        safe_url = escape(url, quote=True)

        result.append(
            f'{index}. <a href="{safe_url}">Открыть подарок</a>'
        )

    return "\n".join(result)


def display_user(user_id: int) -> str:
    user = get_user(user_id)

    if user and user["username"]:
        return "@" + escape(user["username"])

    return f"<code>{user_id}</code>"


