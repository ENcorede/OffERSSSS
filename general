    if selected is None:
        await safe_answer(call, "Неизвестная валюта.", True)
        return

    currency, icon = selected
    await state.update_data(currency=currency, currency_emoji=icon)
    await state.set_state(OfferForm.amount)

    await render_ui(
        state,
        f"{icon} <b>Стоимость оффера</b>\n\n"
        f"Введите сумму в валюте {currency}.\n"
        "Например: <code>100</code>",
