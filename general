@dp.callback_query(F.data == "offer:confirm")
async def offer_confirm(call: CallbackQuery, state: FSMContext):
    if await state.get_state() != OfferForm.confirm.state:
        await safe_answer(
            call,
            "Создание оффера завершено или истекло. Начните заново.",
            True,
        )
        return

    data = await state.get_data()
    recipient = get_user(data.get("recipient_id"))
    urls = data.get("gift_urls", [])

    if not recipient or not urls:
        await render_ui(
            state,
            "Недостаточно данных. Вернитесь в меню и начните заново.",
            main_keyboard(),
        )
        await safe_answer(call, "Недостаточно данных.", True)
        return

    code, offer_id = create_offer(
        call.from_user.id,
        recipient,
        data["currency"],
        data["amount"],
        urls,
    )

    sender = (
        "@" + escape(call.from_user.username)
        if call.from_user.username
        else f"ID <code>{call.from_user.id}</code>"
    )

    recipient_text = (
        f"{E_OFFER} <b>Вам поступило предложение!</b>\n\n"
        f"Отправитель: {sender}\n"
        f"Стоимость: {data['amount']} "
        f"{data['currency_emoji']} {escape(data['currency'])}\n\n"
        f"<b>Подарки ({len(urls)}):</b>\n"
        f"{gift_list_html(urls)}\n\n"
        f"Номер оффера: <code>{code}</code>"
    )

    try:
        await bot.send_message(
            recipient["user_id"],
            recipient_text,
            reply_markup=incoming_keyboard(offer_id),
            disable_web_page_preview=True,
        )
    except TelegramAPIError:
        update_offer(offer_id, "delivery_failed")

        await render_ui(
            state,
            f"{E_REJECT} <b>Оффер не доставлен</b>\n\n"
            "Получатель должен запустить бота через /start. "
            "После этого создайте новый оффер.",
            main_keyboard(),
        )

        await safe_answer(call, "Не удалось отправить оффер.", True)
        return

    await state.clear()
    await save_ui(state, call.message)

    await render_ui(
        state,
        f"{E_ACCEPT} <b>Оффер отправлен</b>\n\n"
        f"Номер: <code>{code}</code>\n"
        f"Количество подарков: <b>{len(urls)}</b>",
        main_keyboard(),
    )

    await safe_answer(call, "Оффер отправлен.")


